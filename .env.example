# ==========================================================================
# Configuración de despliegue — Suite DOLAN Odoo CE 20
# Copiar este archivo como `.env` (está gitignorado) y ajustar los valores.
# NUNCA commitear el `.env` real: contiene credenciales.
# ==========================================================================

# --- PostgreSQL ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambiar_por_password_segura

# --- Base de datos Odoo ---
# Nombre de la base a usar/crear (el entrypoint aplica dbfilter exacto).
DB_NAME=odoo20_dolan

# Password maestro de Odoo (gestor de bases de datos).
ADMIN_PASSWD=cambiar_por_admin_passwd_segura

# "1" para actualizar módulos DOLAN_* automáticamente al levantar.
ODOO_AUTO_UPDATE=0

# Opcional: selección de módulos para instalaciones/perfiles parciales.
# Si quedan vacíos, se usa el catálogo completo DOLAN por compatibilidad.
# En una DB existente, la lista solo determina instalaciones/actualizaciones;
# no desinstala módulos que ya estén activos.
# DOLAN_ADDONS=DOLAN_base,DOLAN_theme,DOLAN_l10n_ar_afip,DOLAN_accounting,DOLAN_ai,DOLAN_ocr,DOLAN_whatsapp,DOLAN_views,DOLAN_subscription,DOLAN_renting,DOLAN_knowledge_bi,DOLAN_exchange
# DOLAN_MODULES=base,web,l10n_ar,l10n_ar_withholding,l10n_ar_stock,project,project_todo,purchase,purchase_stock,DOLAN_base,DOLAN_theme,DOLAN_l10n_ar_afip,DOLAN_accounting,DOLAN_ai,DOLAN_ocr,DOLAN_whatsapp,DOLAN_views,DOLAN_subscription,DOLAN_renting,DOLAN_knowledge_bi,DOLAN_exchange

# --- Puertos ---
ODOO_PORT=8069
# ePOS bridge for generic ESC/POS printers (example: Xprinter XP-E200M)
EPOS_BRIDGE_PORT=8765
EPOS_BRIDGE_PRINTER_HOST=192.168.1.50
EPOS_BRIDGE_PRINTER_PORT=9100
EPOS_BRIDGE_RASTER_WIDTH_DOTS=384
EPOS_BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:8069,http://localhost:8069
WAHA_PORT=3000

# --- WhatsApp (WAHA) ---
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambiar_por_password_segura
# API key de WAHA: generar una cadena aleatoria larga, p. ej.:
#   openssl rand -hex 32
WAHA_API_KEY=cambiar_por_api_key_aleatoria

# --- Dictado local de DOLAN AI (faster-whisper, CPU por defecto) ---
# El modelo se descarga una vez al volumen Docker y después queda local.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
