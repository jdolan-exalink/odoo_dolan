<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_ar_provincial_ddjj_wizard_form" model="ir.ui.view">
        <field name="name">dolan.ar.provincial.ddjj.wizard.form</field>
        <field name="model">dolan.ar.provincial.ddjj.wizard</field>
        <field name="arch" type="xml">
            <form string="DDJJ provinciales de IIBB">
                <field name="state" invisible="1"/>
                <group invisible="state != 'draft'">
                    <group>
                        <field name="report_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <div class="text-muted" invisible="state != 'draft'">
                    ARBA y e-ARCIBA toman las percepciones y retenciones de las jurisdicciones configuradas en
                    Percepciones y retenciones IIBB. SIFERE toma las percepciones de compras y las retenciones de
                    cobros que tienen provincia cargada.
                </div>
                <group invisible="state != 'done'">
                    <field name="line_count"/>
                    <field name="total_amount"/>
                    <field name="result_filename" invisible="1"/>
                    <field name="result_file" filename="result_filename"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generar archivo" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dolan_ar_provincial_ddjj_wizard" model="ir.actions.act_window">
        <field name="name">DDJJ provinciales IIBB</field>
        <field name="res_model">dolan.ar.provincial.ddjj.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_dolan_ar_provincial_ddjj"
              name="DDJJ provinciales IIBB (ARBA, e-ARCIBA, SIFERE)"
              parent="l10n_ar.account_reports_ar_statements_menu"
              action="action_dolan_ar_provincial_ddjj_wizard"
              sequence="20"/>
</odoo>
