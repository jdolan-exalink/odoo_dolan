<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_afip_ws_consult_form" model="ir.ui.view">
        <field name="name">l10n_ar_afip.ws.consult.form</field>
        <field name="model">l10n_ar_afip.ws.consult</field>
        <field name="arch" type="xml">
            <form string="Consultar Comprobantes en ARCA / AFIP">
                <group>
                    <group>
                        <field name="journal_id"/>
                        <field name="available_document_type_ids" invisible="1"/>
                        <field name="document_type_id"/>
                    </group>
                    <group>
                        <field name="consult_type" widget="radio"/>
                        <field name="number" invisible="consult_type != 'specific'" required="consult_type == 'specific'"/>
                    </group>
                </group>
                <group string="Respuesta del Webservice ARCA/AFIP" invisible="not result_text">
                    <field name="recovered_move_id" invisible="not recovered_move_id"/>
                    <field name="recovery_status" invisible="not recovery_status"/>
                    <field name="result_text" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_consult_afip"
                            type="object"
                            string="Consultar en ARCA/AFIP"
                            class="btn-primary"/>
                    <button name="action_import_authorization"
                            type="object"
                            string="Recuperar CAE en comprobante local"
                            class="btn-secondary"
                            invisible="consult_type != 'specific'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ar_afip_ws_consult" model="ir.actions.act_window">
        <field name="name">Consultar Comprobantes en ARCA/AFIP</field>
        <field name="res_model">l10n_ar_afip.ws.consult</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_ar_afip_ws_consult"
              name="Consultar Comprobante en ARCA"
              parent="menu_l10n_ar_afip_root"
              action="action_l10n_ar_afip_ws_consult"
              sequence="20"/>

    <menuitem id="menu_finance_entries_consult_arca"
              name="Consultar factura en ARCA"
              parent="account.menu_finance_entries"
              action="action_l10n_ar_afip_ws_consult"
              sequence="50"/>
</odoo>
