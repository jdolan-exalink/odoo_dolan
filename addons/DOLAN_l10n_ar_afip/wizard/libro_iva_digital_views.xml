<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_libro_iva_digital_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ar.libro.iva.digital.wizard.form</field>
        <field name="model">l10n_ar.libro.iva.digital.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Libro IVA Digital (ARCA)">
                <group>
                    <group string="Parámetros del Período">
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Formato de Presentación">
                        <field name="export_type"/>
                    </group>
                </group>
                <group string="Resumen y Archivos Generados" invisible="not zip_file and not sicore_file">
                    <field name="summary_text" nolabel="1" colspan="2"/>
                    <group string="Archivo SICORE / SIRE" invisible="not sicore_file">
                        <field name="sicore_filename" invisible="1"/>
                        <field name="sicore_file" filename="sicore_filename"/>
                    </group>
                    <group string="Paquete Unificado Libro IVA" invisible="not zip_file">
                        <field name="zip_filename" invisible="1"/>
                        <field name="zip_file" filename="zip_filename"/>
                    </group>
                    <group string="Archivos Individuales TXT" invisible="not zip_file">
                        <field name="ventas_cbte_filename" invisible="1"/>
                        <field name="ventas_cbte_file" filename="ventas_cbte_filename"/>
                        <field name="ventas_alicuotas_filename" invisible="1"/>
                        <field name="ventas_alicuotas_file" filename="ventas_alicuotas_filename"/>
                        <field name="compras_cbte_filename" invisible="1"/>
                        <field name="compras_cbte_file" filename="compras_cbte_filename"/>
                        <field name="compras_alicuotas_filename" invisible="1"/>
                        <field name="compras_alicuotas_file" filename="compras_alicuotas_filename"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_files"
                            type="object"
                            string="Generar Presentación Fiscal"
                            class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ar_libro_iva_digital_wizard" model="ir.actions.act_window">
        <field name="name">Libro IVA Digital y SICORE (ARCA)</field>
        <field name="res_model">l10n_ar.libro.iva.digital.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_l10n_ar_libro_iva_digital"
              name="Resumen de IVA (Libro IVA Digital y SICORE)"
              parent="l10n_ar.account_reports_ar_statements_menu"
              action="action_l10n_ar_libro_iva_digital_wizard"
              sequence="5"/>
</odoo>
