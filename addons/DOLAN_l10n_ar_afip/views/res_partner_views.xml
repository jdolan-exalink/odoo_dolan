<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_dolan_l10n_ar_padron" model="ir.ui.view">
        <field name="name">res.partner.form.dolan.l10n_ar.padron</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <button name="action_l10n_ar_update_from_padron"
                        type="object"
                        string="Consultar ARCA"
                        icon="fa-search"
                        help="Consulta el Padrón ARCA/AFIP por CUIT para autocompletar los datos fiscales con el certificado autorizado."
                        class="btn btn-sm btn-outline-primary ms-1 py-0 px-2"/>
            </xpath>
            <xpath expr="//div[@id='vat_div']" position="after">
                <field name="l10n_ar_padron_status" invisible="not l10n_ar_padron_status" readonly="1" class="text-muted small"/>
                <field name="l10n_ar_padron_last_update" invisible="not l10n_ar_padron_last_update" readonly="1" class="text-muted small"/>
                <field name="l10n_ar_padron_error" invisible="not l10n_ar_padron_error" readonly="1" class="text-danger small"/>
            </xpath>
        </field>
    </record>
</odoo>
