<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_inherit_dolan_ar_status" model="ir.ui.view">
        <field name="name">account.move.out.invoice.list.dolan.ar.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">invoice_date desc, name desc, id desc</attribute>
                <attribute name="create">Nueva</attribute>
                <attribute name="import">false</attribute>
                <attribute name="js_class">dolan_out_invoice_tree</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="replace">
                <field name="l10n_ar_invoice_date_display" string="Fecha"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="replace">
                <field name="l10n_ar_invoice_due_date_display" string="Vencimiento"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="replace">
                <field name="l10n_ar_company_is_ri" column_invisible="True"/>
                <field name="l10n_ar_invoice_vat_amount"
                       string="IVA"
                       invisible="not l10n_ar_company_is_ri"/>
            </xpath>
            <xpath expr="//field[@name='amount_residual_signed']" position="replace"/>
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_ar_afip_cae_indicator"
                       string="CAE"
                       widget="badge"
                       optional="show"
                       decoration-success="l10n_ar_afip_cae_indicator == '✓'"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="width">180px</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_id'])[last()]" position="attributes">
                <attribute name="width">180px</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="string">Empresa</attribute>
                <attribute name="width">150px</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="column_invisible">context.get('allowed_company_ids', []).length &lt;= 1</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ar_afip_cae_indicator']" position="after">
                <field name="company_id" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_dolan_l10n_ar_afip" model="ir.ui.view">
        <field name="name">account.move.form.dolan.l10n_ar_afip</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Keep invoice line headings in Argentine Spanish regardless of
                 the browser user's language, including the embedded product
                 column labels inherited from the upstream English view. -->
            <xpath expr="//field[@name='invoice_line_ids']/list/column[@name='product_and_description']" position="attributes">
                <attribute name="string">Producto</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/column[@name='product_and_description']/field[@name='product_id']" position="attributes">
                <attribute name="string">Producto</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="string">Cantidad</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="string">Precio Unitario</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="string">Impuestos</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Total</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_total']" position="attributes">
                <attribute name="string">Total</attribute>
            </xpath>
            <!-- For Argentine customer documents, display ARCA fiscal status in
                 place of the generic Odoo state label. The underlying posted
                 accounting state is unchanged. -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">l10n_ar_afip_display_status</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state'][1]" position="before">
                <field name="l10n_ar_afip_display_status"
                       widget="badge"
                       invisible="not l10n_ar_afip_display_status"
                       decoration-info="l10n_ar_afip_display_status in ('draft', 'draft_no_cae')"
                       decoration-warning="l10n_ar_afip_display_status == 'caea_pending'"
                       decoration-success="l10n_ar_afip_display_status in ('authorized', 'authorized_observations')"
                       decoration-danger="l10n_ar_afip_display_status == 'rejected'"
                       decoration-muted="l10n_ar_afip_display_status == 'cancel'"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_l10n_ar_request_cae"
                        type="object"
                        string="Solicitar CAE (ARCA/AFIP)"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or bool(l10n_ar_afip_auth_code)"/>
                <button name="action_l10n_ar_caea_inform"
                        type="object"
                        string="Informar CAEA a ARCA"
                        class="btn-secondary"
                        invisible="l10n_ar_caea_report_state not in ('pending', 'rejected')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="ARCA / AFIP Factura Electrónica"
                      name="l10n_ar_afip_edi"
                      invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <group>
                        <group string="Autorización Electrónica ARCA/AFIP">
                            <field name="l10n_ar_afip_auth_mode"/>
                            <field name="l10n_ar_afip_auth_code"/>
                            <field name="l10n_ar_afip_auth_code_due"/>
                            <field name="l10n_ar_caea_id" invisible="not l10n_ar_caea_id"/>
                            <field name="l10n_ar_caea_report_state" invisible="not l10n_ar_caea_id"/>
                            <field name="l10n_ar_caea_generated_at" invisible="not l10n_ar_caea_id"/>
                            <field name="l10n_ar_caea_report_message" invisible="not l10n_ar_caea_report_message"/>
                            <field name="l10n_ar_afip_result" widget="badge"
                                   decoration-success="l10n_ar_afip_result == 'A'"
                                   decoration-warning="l10n_ar_afip_result == 'O'"
                                   decoration-danger="l10n_ar_afip_result == 'R'"/>
                        </group>
                        <group string="Datos fiscales adicionales">
                            <field name="l10n_ar_transparent_vat_amount"/>
                            <field name="l10n_ar_fce_cbu_id"/>
                            <field name="l10n_ar_afip_qr_code" widget="url"/>
                            <field name="l10n_ar_afip_asoc_period_start"/>
                            <field name="l10n_ar_afip_asoc_period_end"/>
                        </group>
                        <field name="l10n_ar_journal_pos_system" invisible="1"/>
                        <group string="Exportación (Factura E)"
                               invisible="l10n_ar_journal_pos_system != 'DOLAN_WSFEX'">
                            <field name="l10n_ar_export_permit_existing"/>
                            <field name="l10n_ar_export_permit_number"
                                   invisible="l10n_ar_export_permit_existing != 'S'"/>
                            <field name="l10n_ar_export_permit_country_id"
                                   invisible="l10n_ar_export_permit_existing != 'S'"/>
                            <field name="invoice_incoterm_id"/>
                            <field name="l10n_ar_export_language"/>
                            <field name="l10n_ar_export_commercial_notes"/>
                        </group>
                    </group>
                    <group string="Auditoría XML Webservice ARCA/AFIP" groups="base.group_no_one">
                        <field name="l10n_ar_afip_xml_request"/>
                        <field name="l10n_ar_afip_xml_response"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form_inherit_dolan_l10n_ar_afip" model="ir.ui.view">
        <field name="name">account.journal.form.dolan.l10n_ar_afip</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="l10n_ar_afip_ws" invisible="type != 'sale'"/>
                <field name="l10n_ar_caea_journal_id"
                       invisible="type != 'sale' or l10n_ar_afip_pos_system != 'DOLAN_WSFE'"/>
            </xpath>
        </field>
    </record>
</odoo>
