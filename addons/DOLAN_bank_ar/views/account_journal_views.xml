<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_dolan_bank_ar" model="ir.ui.view">
        <field name="name">account.journal.form.dolan.bank.ar</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="bank_statements_source" position="after">
                <field name="dolan_bank_profile" invisible="type != 'bank'"/>
                <field name="dolan_idc_credit_rate" invisible="type != 'bank'" groups="account.group_account_manager"/>
                <field name="dolan_idc_credit_account_id" invisible="type != 'bank'" groups="account.group_account_manager"/>
            </field>
        </field>
    </record>
</odoo>
