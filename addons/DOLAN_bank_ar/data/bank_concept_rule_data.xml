<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Completar la cuenta contable de cada regla en Contabilidad > Configuración > Reglas bancarias -->
        <record id="rule_idc" model="dolan.bank.concept.rule">
            <field name="name">Impuesto a los débitos y créditos (Ley 25.413)</field>
            <field name="sequence">10</field>
            <field name="kind">idc</field>
            <field name="pattern">25\.?413|imp(uesto)?\.?\s*(s/)?\s*(deb|cred|db|cr)|\bidc\b|deb\.?\s*y\s*cred</field>
        </record>
        <record id="rule_sircreb" model="dolan.bank.concept.rule">
            <field name="name">SIRCREB / Ingresos Brutos</field>
            <field name="sequence">20</field>
            <field name="kind">sircreb</field>
            <field name="pattern">sircreb|ing(resos)?\.?\s*brutos|\biibb\b|reg\.?\s*recaud</field>
        </record>
        <record id="rule_vat" model="dolan.bank.concept.rule">
            <field name="name">IVA y percepciones de IVA</field>
            <field name="sequence">30</field>
            <field name="kind">vat</field>
            <field name="pattern">\biva\b|percep\w*\s+iva|rg\s*2408</field>
        </record>
        <record id="rule_commission" model="dolan.bank.concept.rule">
            <field name="name">Comisiones y gastos bancarios</field>
            <field name="sequence">40</field>
            <field name="kind">commission</field>
            <field name="pattern">comisi[oó]n|mantenimiento|cargo\s+por|gastos?\s+banc|com\.\s</field>
        </record>
        <record id="rule_interest" model="dolan.bank.concept.rule">
            <field name="name">Intereses</field>
            <field name="sequence">50</field>
            <field name="kind">interest</field>
            <field name="pattern">inter[eé]s|intereses</field>
        </record>
    </data>
</odoo>
