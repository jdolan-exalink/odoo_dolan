<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_check_reject_wizard_form" model="ir.ui.view">
        <field name="name">dolan.check.reject.wizard.form</field>
        <field name="model">dolan.check.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar rechazo de cheque">
                <p class="text-muted">
                    Se vuelve a abrir la deuda del cliente por el importe del cheque y se descuenta del
                    lugar donde está (cartera o banco donde se depositó).
                </p>
                <group>
                    <field name="check_ids" widget="many2many_tags" readonly="1"/>
                    <field name="date"/>
                    <field name="reason"/>
                    <field name="note"/>
                    <field name="fee_amount"/>
                    <field name="charge_fee" invisible="not fee_amount"/>
                    <field name="fee_account_id" invisible="not fee_amount or charge_fee"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar rechazo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
