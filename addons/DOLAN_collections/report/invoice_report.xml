<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_dolan_payment_qr" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='payment_term']" position="after">
            <t t-set="dolan_qr" t-value="o.dolan_payment_qr_uri()"/>
            <div t-if="dolan_qr" id="dolan_payment_qr" class="d-flex align-items-center gap-3 mt-3 avoid-page-break-inside">
                <img t-att-src="dolan_qr" style="width: 110px; height: 110px;" alt="QR de pago"/>
                <div>
                    <strong>Pagá esta factura online</strong><br/>
                    <span>Escaneá el código QR o ingresá a:</span><br/>
                    <a t-att-href="o.dolan_payment_url" t-out="o.dolan_payment_url" style="word-break: break-all;"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
