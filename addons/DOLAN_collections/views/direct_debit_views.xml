<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_direct_debit_batch_list" model="ir.ui.view">
        <field name="name">dolan.direct.debit.batch.list</field>
        <field name="model">dolan.direct.debit.batch</field>
        <field name="arch" type="xml">
            <list string="Débito automático">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_direct_debit_batch_form" model="ir.ui.view">
        <field name="name">dolan.direct.debit.batch.form</field>
        <field name="model">dolan.direct.debit.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de débito automático">
                <header>
                    <button name="action_load_invoices" type="object" string="Cargar facturas vencidas"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_file" type="object" string="Generar archivo para el banco"
                            class="btn-primary" invisible="state not in ('draft', 'sent') or not line_ids"/>
                    <button name="action_register_collections" type="object" string="Registrar cobros"
                            class="btn-primary" invisible="state != 'sent'"
                            confirm="Se registran como cobrados los débitos que no marcaste como rechazados. ¿Continuar?"/>
                    <button name="action_cancel" type="object" string="Anular" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="due_until" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total"/>
                            <field name="file_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom" decoration-danger="state == 'rejected'" decoration-success="state == 'paid'">
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="cbu_id"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Total"/>
                            <field name="state"/>
                            <field name="reject_reason" optional="show"/>
                            <button name="action_mark_rejected" type="object" string="Rechazado" icon="fa-ban"
                                    invisible="state != 'pending'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dolan_direct_debit_batch" model="ir.actions.act_window">
        <field name="name">Débito automático</field>
        <field name="res_model">dolan.direct.debit.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dolan_direct_debit_batch" name="Débito automático por CBU"
              parent="account.menu_finance_receivables" action="action_dolan_direct_debit_batch" sequence="90"/>
</odoo>
