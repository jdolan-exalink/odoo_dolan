<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_dolan_collections" model="ir.ui.view">
        <field name="name">account.move.form.dolan.collections</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dolan_payment_link" type="object" string="Generar link de pago"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state not in ('not_paid', 'partial') or dolan_payment_url"/>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="dolan_payment_url" widget="url" invisible="not dolan_payment_url"/>
            </xpath>
        </field>
    </record>
</odoo>
