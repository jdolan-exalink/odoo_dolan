<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_review_cycle_list" model="ir.ui.view">
        <field name="name">dolan.hr.review.cycle.list</field>
        <field name="model">dolan.hr.review.cycle</field>
        <field name="arch" type="xml">
            <list string="Ciclos de evaluación">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_review_cycle_form" model="ir.ui.view">
        <field name="name">dolan.hr.review.cycle.form</field>
        <field name="model">dolan.hr.review.cycle</field>
        <field name="arch" type="xml">
            <form string="Ciclo de evaluación">
                <header>
                    <button name="action_open" type="object" string="Abrir y crear evaluaciones" class="btn-primary"
                            invisible="state == 'closed'"/>
                    <button name="action_close" type="object" string="Cerrar ciclo" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="review_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="reviewer_id"/>
                            <field name="objectives_score"/>
                            <field name="rating"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_review_cycle" model="ir.actions.act_window">
        <field name="name">Ciclos de evaluación</field>
        <field name="res_model">dolan.hr.review.cycle</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dolan_hr_review_list" model="ir.ui.view">
        <field name="name">dolan.hr.review.list</field>
        <field name="model">dolan.hr.review</field>
        <field name="arch" type="xml">
            <list string="Evaluaciones" create="0">
                <field name="cycle_id"/>
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <field name="objectives_score"/>
                <field name="rating"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_review_form" model="ir.ui.view">
        <field name="name">dolan.hr.review.form</field>
        <field name="model">dolan.hr.review</field>
        <field name="arch" type="xml">
            <form string="Evaluación de desempeño" create="0">
                <header>
                    <button name="action_send" type="object" string="Enviar al empleado" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_acknowledge" type="object" string="Dejar mi comentario"
                            class="btn-primary" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="cycle_id" readonly="1"/>
                            <field name="reviewer_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="objectives_score"/>
                            <field name="rating" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objetivos" name="objectives">
                            <field name="objective_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="target"/>
                                    <field name="weight"/>
                                    <field name="achievement"/>
                                </list>
                            </field>
                        </page>
                        <page string="Devolución" name="feedback">
                            <group>
                                <field name="strengths" readonly="state != 'draft'"/>
                                <field name="improvements" readonly="state != 'draft'"/>
                                <field name="employee_comment" readonly="state != 'sent'"/>
                            </group>
                        </page>
                        <page string="Nota privada" name="private" groups="hr.group_hr_manager">
                            <field name="private_note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_review" model="ir.actions.act_window">
        <field name="name">Evaluaciones</field>
        <field name="res_model">dolan.hr.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
