<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dolan_scheduling" model="ir.ui.view">
        <field name="name">res.company.form.dolan.scheduling</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="dolan_scheduling" string="Turnos" groups="hr.group_hr_manager">
                    <group>
                        <field name="dolan_min_rest_hours" widget="float_time"/>
                        <field name="dolan_night_start" widget="float_time"/>
                        <field name="dolan_night_end" widget="float_time"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
