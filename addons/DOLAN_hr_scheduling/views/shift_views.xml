<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_shift_list" model="ir.ui.view">
        <field name="name">dolan.hr.shift.list</field>
        <field name="model">dolan.hr.shift</field>
        <field name="arch" type="xml">
            <list string="Turnos tipo">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="crosses_midnight"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="night_hours" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_shift_form" model="ir.ui.view">
        <field name="name">dolan.hr.shift.form</field>
        <field name="model">dolan.hr.shift</field>
        <field name="arch" type="xml">
            <form string="Turno tipo">
                <sheet>
                    <group>
                        <group string="Horario">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="start_hour" widget="float_time"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="crosses_midnight"/>
                        </group>
                        <group string="Pausas y tramos">
                            <field name="break_minutes"/>
                            <field name="break_paid"/>
                            <field name="split_start_hour" widget="float_time"/>
                            <field name="split_duration_hours" widget="float_time"/>
                        </group>
                        <group string="Control">
                            <field name="tolerance_minutes"/>
                            <field name="flexible_band_minutes"/>
                            <field name="worked_hours" widget="float_time"/>
                            <field name="night_hours" widget="float_time"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_shift" model="ir.actions.act_window">
        <field name="name">Turnos tipo</field>
        <field name="res_model">dolan.hr.shift</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dolan_hr_shift_pattern_list" model="ir.ui.view">
        <field name="name">dolan.hr.shift.pattern.list</field>
        <field name="model">dolan.hr.shift.pattern</field>
        <field name="arch" type="xml">
            <list string="Plantillas">
                <field name="name"/>
                <field name="kind"/>
                <field name="cycle_length"/>
                <field name="weekly_hours" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_shift_pattern_form" model="ir.ui.view">
        <field name="name">dolan.hr.shift.pattern.form</field>
        <field name="model">dolan.hr.shift.pattern</field>
        <field name="arch" type="xml">
            <form string="Plantilla de turnos">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="cycle_length"/>
                            <field name="weekly_hours" widget="float_time"/>
                            <field name="target_weekly_hours" invisible="kind != 'flexible'" widget="float_time"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="day_index"/>
                            <field name="shift_id" placeholder="Franco"/>
                            <field name="is_off"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notas"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_shift_pattern" model="ir.actions.act_window">
        <field name="name">Plantillas de turnos</field>
        <field name="res_model">dolan.hr.shift.pattern</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
