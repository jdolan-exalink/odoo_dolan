<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_shift_assignment_calendar" model="ir.ui.view">
        <field name="name">dolan.hr.shift.assignment.calendar</field>
        <field name="model">dolan.hr.shift.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Turnos" date_start="start_datetime" date_stop="end_datetime" color="shift_id"
                      mode="week" event_open_popup="1" quick_create="0">
                <field name="employee_id" filters="1"/>
                <field name="shift_id" filters="1"/>
                <field name="crew_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_dolan_hr_shift_assignment_list" model="ir.ui.view">
        <field name="name">dolan.hr.shift.assignment.list</field>
        <field name="model">dolan.hr.shift.assignment</field>
        <field name="arch" type="xml">
            <list string="Turnos" decoration-muted="state in ('superseded', 'cancelled')" decoration-info="state == 'draft'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="segment" optional="hide"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="planned_hours" widget="float_time" sum="Total"/>
                <field name="night_hours" widget="float_time" optional="show" sum="Total"/>
                <field name="crew_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_shift_assignment_form" model="ir.ui.view">
        <field name="name">dolan.hr.shift.assignment.form</field>
        <field name="model">dolan.hr.shift.assignment</field>
        <field name="arch" type="xml">
            <form string="Turno">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="shift_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="start_datetime" readonly="state != 'draft'"/>
                            <field name="end_datetime" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="schedule_id" readonly="1"/>
                            <field name="crew_id" readonly="state != 'draft'"/>
                            <field name="origin" readonly="1"/>
                            <field name="replaces_employee_id" readonly="state != 'draft'"/>
                            <field name="planned_hours" widget="float_time" readonly="state != 'draft'"/>
                            <field name="night_hours" widget="float_time" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Nota"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dolan_hr_shift_assignment_pivot" model="ir.ui.view">
        <field name="name">dolan.hr.shift.assignment.pivot</field>
        <field name="model">dolan.hr.shift.assignment</field>
        <field name="arch" type="xml">
            <pivot string="Horas planificadas">
                <field name="employee_id" type="row"/>
                <field name="date" interval="week" type="col"/>
                <field name="planned_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dolan_hr_shift_assignment_search" model="ir.ui.view">
        <field name="name">dolan.hr.shift.assignment.search</field>
        <field name="model">dolan.hr.shift.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="crew_id"/>
                <field name="department_id"/>
                <filter name="published" string="Publicados" domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="night" string="Con horas nocturnas" domain="[('night_hours', '>', 0)]"/>
                <group>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_crew" string="Cuadrilla" context="{'group_by': 'crew_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_hr_shift_assignment" model="ir.actions.act_window">
        <field name="name">Turnos</field>
        <field name="res_model">dolan.hr.shift.assignment</field>
        <field name="view_mode">calendar,list,pivot,form</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>

    <record id="action_dolan_hr_my_shifts" model="ir.actions.act_window">
        <field name="name">Mis turnos</field>
        <field name="res_model">dolan.hr.shift.assignment</field>
        <field name="view_mode">calendar,list</field>
        <field name="domain">[('employee_id.user_id', '=', uid), ('state', '=', 'published')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_employee_form_dolan_scheduling" model="ir.ui.view">
        <field name="name">hr.employee.form.dolan.scheduling</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_dolan_open_shifts" type="object" class="oe_stat_button" icon="fa-calendar"
                        groups="hr.group_hr_user">
                    <field name="dolan_shift_count" widget="statinfo" string="Turnos"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
