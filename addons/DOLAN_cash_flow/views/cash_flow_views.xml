<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_cash_flow_report_form" model="ir.ui.view">
        <field name="name">dolan.cash.flow.report.form</field>
        <field name="model">dolan.cash.flow.report</field>
        <field name="arch" type="xml">
            <form string="Flujo de caja proyectado">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_start"/>
                        <field name="periodicity" widget="radio" options="{'horizontal': true}"/>
                        <field name="periods"/>
                    </group>
                    <group string="Escenario">
                        <field name="overdue_collection_pct"/>
                        <field name="overdue_collection_days"/>
                        <field name="include_checks"/>
                    </group>
                </group>
                <p class="text-muted">
                    El saldo inicial es el de las cuentas de caja y bancos según la contabilidad. Las cobranzas y pagos
                    salen de los comprobantes abiertos por vencimiento; las previsiones manuales se cargan en
                    «Previsiones».
                </p>
                <footer>
                    <button name="action_compute" type="object" string="Calcular" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dolan_cash_flow_report" model="ir.actions.act_window">
        <field name="name">Flujo de caja</field>
        <field name="res_model">dolan.cash.flow.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_dolan_cash_flow_line_list" model="ir.ui.view">
        <field name="name">dolan.cash.flow.line.list</field>
        <field name="model">dolan.cash.flow.line</field>
        <field name="arch" type="xml">
            <list string="Flujo de caja proyectado" create="false" edit="false" decoration-danger="closing &lt; 0">
                <field name="name"/>
                <field name="opening"/>
                <field name="in_receivable" sum="Total"/>
                <field name="in_checks" sum="Total" optional="show"/>
                <field name="in_manual" sum="Total" optional="show"/>
                <field name="out_payable" sum="Total"/>
                <field name="out_checks" sum="Total" optional="show"/>
                <field name="out_manual" sum="Total" optional="show"/>
                <field name="net" sum="Total"/>
                <field name="closing"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_cash_flow_line_graph" model="ir.ui.view">
        <field name="name">dolan.cash.flow.line.graph</field>
        <field name="model">dolan.cash.flow.line</field>
        <field name="arch" type="xml">
            <graph string="Saldo proyectado" type="line" order="sequence">
                <field name="name"/>
                <field name="closing" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dolan_cash_forecast_list" model="ir.ui.view">
        <field name="name">dolan.cash.forecast.list</field>
        <field name="model">dolan.cash.forecast</field>
        <field name="arch" type="xml">
            <list string="Previsiones" editable="bottom">
                <field name="date"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="amount"/>
                <field name="repeat_months"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_cash_forecast" model="ir.actions.act_window">
        <field name="name">Previsiones</field>
        <field name="res_model">dolan.cash.forecast</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Cargá entradas y salidas que todavía no tienen comprobante: sueldos, alquileres, impuestos, préstamos.</p>
        </field>
    </record>

    <menuitem id="menu_dolan_cash_flow_root" name="Flujo de caja" sequence="47"
              groups="account.group_account_manager"
              web_icon="DOLAN_theme,static/src/lib/fluent_flat/catalog_cash_flow.svg"/>
    <menuitem id="menu_dolan_cash_flow_report" name="Proyección" parent="menu_dolan_cash_flow_root"
              action="action_dolan_cash_flow_report" sequence="10"/>
    <menuitem id="menu_dolan_cash_flow_forecast" name="Previsiones" parent="menu_dolan_cash_flow_root"
              action="action_dolan_cash_forecast" sequence="20"/>
</odoo>
