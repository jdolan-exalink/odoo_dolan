<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_document_list" model="ir.ui.view">
        <field name="name">dolan.hr.document.list</field>
        <field name="model">dolan.hr.document</field>
        <field name="arch" type="xml">
            <list string="Documentos del legajo" decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'" decoration-muted="state == 'archived'">
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="name"/>
                <field name="issue_date" optional="show"/>
                <field name="expiry_date"/>
                <field name="acknowledged" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_document_form" model="ir.ui.view">
        <field name="name">dolan.hr.document.form</field>
        <field name="model">dolan.hr.document</field>
        <field name="arch" type="xml">
            <form string="Documento del legajo">
                <header>
                    <button name="action_acknowledge" type="object" string="Dar conformidad" class="btn-primary"
                            invisible="acknowledged or not file"/>
                    <button name="action_archive_document" type="object" string="Archivar"
                            invisible="state == 'archived'" groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="type_id"/>
                            <field name="name"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="confidential"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Conformidad" invisible="not acknowledged_by">
                        <field name="acknowledged"/>
                        <field name="acknowledged_by"/>
                        <field name="acknowledged_on"/>
                        <field name="acknowledged_hash" groups="base.group_no_one"/>
                        <field name="file_hash" groups="base.group_no_one"/>
                    </group>
                    <field name="note" placeholder="Notas"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dolan_hr_document_search" model="ir.ui.view">
        <field name="name">dolan.hr.document.search</field>
        <field name="model">dolan.hr.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="type_id"/>
                <filter name="expiring" string="Por vencer" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Vencidos" domain="[('state', '=', 'expired')]"/>
                <filter name="current" string="Sin archivar" domain="[('state', '!=', 'archived')]"/>
                <filter name="no_ack" string="Sin conformidad" domain="[('acknowledged_by', '=', False)]"/>
                <group>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_hr_document" model="ir.actions.act_window">
        <field name="name">Legajo digital</field>
        <field name="res_model">dolan.hr.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
    </record>

    <record id="action_dolan_hr_document_expiring" model="ir.actions.act_window">
        <field name="name">Vencimientos</field>
        <field name="res_model">dolan.hr.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('expiring', 'expired'))]</field>
    </record>

    <record id="view_dolan_hr_document_type_list" model="ir.ui.view">
        <field name="name">dolan.hr.document.type.list</field>
        <field name="model">dolan.hr.document.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de documento" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="requires_expiry"/>
                <field name="validity_months"/>
                <field name="alert_days"/>
                <field name="mandatory"/>
                <field name="confidential"/>
                <field name="employee_visible"/>
                <field name="requires_acknowledgement"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_hr_document_type" model="ir.actions.act_window">
        <field name="name">Tipos de documento</field>
        <field name="res_model">dolan.hr.document.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_employee_form_dolan_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.dolan.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_dolan_documents" type="object" class="oe_stat_button" icon="fa-folder-open"
                        groups="hr.group_hr_user">
                    <field name="dolan_document_count" widget="statinfo" string="Documentos"/>
                </button>
            </div>
        </field>
    </record>

    <menuitem id="menu_dolan_hr_documents" name="Legajo digital" parent="hr.menu_hr_root" sequence="15"
              groups="hr.group_hr_user"/>
    <menuitem id="menu_dolan_hr_documents_all" name="Documentos" parent="menu_dolan_hr_documents"
              action="action_dolan_hr_document" sequence="10"/>
    <menuitem id="menu_dolan_hr_documents_expiring" name="Vencimientos" parent="menu_dolan_hr_documents"
              action="action_dolan_hr_document_expiring" sequence="20"/>
    <menuitem id="menu_dolan_hr_document_types" name="Tipos de documento" parent="hr.menu_human_resources_configuration"
              action="action_dolan_hr_document_type" sequence="40" groups="hr.group_hr_manager"/>
</odoo>
