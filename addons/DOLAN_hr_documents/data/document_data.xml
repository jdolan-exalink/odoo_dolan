<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="document_type_dni" model="dolan.hr.document.type">
            <field name="name">DNI</field>
            <field name="code">DNI</field>
            <field name="mandatory" eval="True"/>
            <field name="sequence">10</field>
        </record>
        <record id="document_type_cuil" model="dolan.hr.document.type">
            <field name="name">Constancia de CUIL</field>
            <field name="code">CUIL</field>
            <field name="mandatory" eval="True"/>
            <field name="sequence">20</field>
        </record>
        <record id="document_type_alta" model="dolan.hr.document.type">
            <field name="name">Alta temprana (Mi Simplificación)</field>
            <field name="code">ALTA</field>
            <field name="mandatory" eval="True"/>
            <field name="employee_visible" eval="True"/>
            <field name="sequence">30</field>
        </record>
        <record id="document_type_contract" model="dolan.hr.document.type">
            <field name="name">Contrato de trabajo</field>
            <field name="code">CONTRATO</field>
            <field name="requires_acknowledgement" eval="True"/>
            <field name="sequence">40</field>
        </record>
        <record id="document_type_medical" model="dolan.hr.document.type">
            <field name="name">Examen médico preocupacional / periódico</field>
            <field name="code">APTO</field>
            <field name="requires_expiry" eval="True"/>
            <field name="validity_months">12</field>
            <field name="alert_days">30</field>
            <field name="confidential" eval="True"/>
            <field name="sequence">50</field>
        </record>
        <record id="document_type_driver" model="dolan.hr.document.type">
            <field name="name">Licencia de conducir</field>
            <field name="code">LICCOND</field>
            <field name="requires_expiry" eval="True"/>
            <field name="alert_days">45</field>
            <field name="sequence">60</field>
        </record>
        <record id="document_type_policy" model="dolan.hr.document.type">
            <field name="name">Reglamento interno / políticas</field>
            <field name="code">REGLAMENTO</field>
            <field name="requires_acknowledgement" eval="True"/>
            <field name="sequence">70</field>
        </record>
        <record id="document_type_certificate" model="dolan.hr.document.type">
            <field name="name">Certificado médico de licencia</field>
            <field name="code">CERTMED</field>
            <field name="confidential" eval="True"/>
            <field name="sequence">80</field>
        </record>
        <record id="ir_cron_dolan_document_expiry" model="ir.cron">
            <field name="name">Personal: vencimientos de documentos del legajo</field>
            <field name="model_id" ref="model_dolan_hr_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_dolan_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
