<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_shift_swap_list" model="ir.ui.view">
        <field name="name">dolan.hr.shift.swap.list</field>
        <field name="model">dolan.hr.shift.swap</field>
        <field name="arch" type="xml">
            <list string="Cambios de turno" create="0" decoration-warning="state == 'pending'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="assignment_id"/>
                <field name="replacement_id"/>
                <field name="reason"/>
                <field name="decided_by" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_shift_swap_form" model="ir.ui.view">
        <field name="name">dolan.hr.shift.swap.form</field>
        <field name="model">dolan.hr.shift.swap</field>
        <field name="arch" type="xml">
            <form string="Cambio de turno" create="0">
                <header>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary"
                            invisible="state != 'pending'" groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'pending'" groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="assignment_id"/>
                            <field name="date"/>
                            <field name="replacement_id"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="decision_note" readonly="state != 'pending'"/>
                            <field name="decided_by" invisible="not decided_by"/>
                            <field name="new_assignment_id" invisible="not new_assignment_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_shift_swap" model="ir.actions.act_window">
        <field name="name">Cambios de turno</field>
        <field name="res_model">dolan.hr.shift.swap</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="view_dolan_hr_shift_swap_search" model="ir.ui.view">
        <field name="name">dolan.hr.shift.swap.search</field>
        <field name="model">dolan.hr.shift.swap</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_dolan_shift_swaps" name="Cambios de turno" parent="DOLAN_hr_scheduling.menu_dolan_scheduling_planning"
              action="action_dolan_hr_shift_swap" sequence="25"/>
</odoo>
