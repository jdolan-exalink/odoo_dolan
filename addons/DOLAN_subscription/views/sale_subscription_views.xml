<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================================= -->
    <!-- VISTAS DE CONTRATOS DE SUSCRIPCIÓN (dolan.subscription)   -->
    <!-- ========================================================= -->

    <!-- Search View -->
    <record id="view_dolan_subscription_search" model="ir.ui.view">
        <field name="name">dolan.subscription.search</field>
        <field name="model">dolan.subscription</field>
        <field name="arch" type="xml">
            <search string="Buscar Suscripciones">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <filter string="Activas" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="En Borrador" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pausadas" name="filter_paused" domain="[('state', '=', 'paused')]"/>
                <filter string="Cerradas / Bajas" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Por Facturar (Vencidas o Hoy)" name="filter_to_invoice"
                        domain="[('state', '=', 'active'), ('next_invoice_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Mis Suscripciones" name="filter_my_subs" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Plan de Recurrencia" name="group_by_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Cliente" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Comercial" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Próxima Factura" name="group_by_next_invoice" context="{'group_by': 'next_invoice_date:month'}"/>
                    <filter string="Motivo de Baja" name="group_by_close_reason" context="{'group_by': 'close_reason_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View (Odoo 20 <list>) -->
    <record id="view_dolan_subscription_list" model="ir.ui.view">
        <field name="name">dolan.subscription.list</field>
        <field name="model">dolan.subscription</field>
        <field name="arch" type="xml">
            <list string="Suscripciones" sample="1"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'paused'"
                  decoration-muted="state == 'closed'">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="date_start" optional="show"/>
                <field name="next_invoice_date" widget="remaining_days"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="recurring_total" sum="Total Período" widget="monetary"/>
                <field name="mrr" sum="Total MRR" widget="monetary" decoration-bf="1"/>
                <field name="arr" sum="Total ARR" widget="monetary" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"
                       decoration-danger="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View (Odoo 20 <t t-name="card">) -->
    <record id="view_dolan_subscription_kanban" model="ir.ui.view">
        <field name="name">dolan.subscription.kanban</field>
        <field name="model">dolan.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="next_invoice_date"/>
                <field name="mrr"/>
                <field name="arr"/>
                <field name="recurring_total"/>
                <field name="currency_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="color"/>
                <progressbar field="state" colors='{"active": "success", "paused": "warning", "closed": "danger", "draft": "info"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="o_kanban_record_title">
                                <field name="name"/> — <field name="partner_id"/>
                            </strong>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'draft': 'info', 'active': 'success', 'paused': 'warning', 'closed': 'danger'}}"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <span class="me-2"><i class="fa fa-repeat me-1" title="Plan"/> <field name="plan_id"/></span>
                            <span><i class="fa fa-calendar me-1" title="Próxima factura"/> Próx.: <field name="next_invoice_date"/></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-auto">
                            <div>
                                <span class="badge text-bg-primary me-1">
                                    MRR: <field name="mrr" widget="monetary"/>
                                </span>
                                <span class="badge text-bg-secondary">
                                    ARR: <field name="arr" widget="monetary"/>
                                </span>
                            </div>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dolan_subscription_form" model="ir.ui.view">
        <field name="name">dolan.subscription.form</field>
        <field name="model">dolan.subscription</field>
        <field name="arch" type="xml">
            <form string="Contrato de Suscripción">
                <header>
                    <button name="action_start_subscription"
                            string="Activar Suscripción"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_recurring_invoice"
                            string="Generar Factura Ahora"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'active'"/>
                    <button name="action_pause_subscription"
                            string="Pausar"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_resume_subscription"
                            string="Reactivar"
                            type="object"
                            class="btn-success"
                            invisible="state != 'paused'"/>
                    <button name="action_close_subscription"
                            string="Cerrar / Dar de Baja"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('active', 'paused')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Contrato de Suscripción"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Cliente y Plan">
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="billing_period"/>
                            <field name="code" placeholder="Ej. CONTRATO-2026-001"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Vigencia e Ingresos Recurrentes (MRR / ARR)">
                            <field name="date_start"/>
                            <field name="next_invoice_date"/>
                            <field name="date_end" invisible="state != 'closed' and not date_end"/>
                            <field name="mrr" widget="monetary" decoration-bf="1"/>
                            <field name="arr" widget="monetary"/>
                            <field name="auto_renew"/>
                            <field name="auto_send_email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas Recurrentes" name="lines">
                            <field name="line_ids">
                                <list string="Líneas de Suscripción" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" groups="uom.group_uom" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="line_mrr" widget="monetary" optional="show"/>
                                    <field name="price_total" widget="monetary" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="subscription_total">
                                <field name="recurring_untaxed" widget="monetary"/>
                                <field name="recurring_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="recurring_total"/>
                                </div>
                                <field name="recurring_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Comercial, CRM y Proyectos" name="commercial">
                            <group>
                                <group string="Asignación Comercial">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="team_id"/>
                                    <field name="opportunity_id"/>
                                    <field name="project_id"/>
                                    <field name="sale_order_id"/>
                                </group>
                                <group string="Facturación y Baja">
                                    <field name="journal_id"/>
                                    <field name="payment_term_id"/>
                                    <field name="close_reason_id" invisible="state != 'closed'"/>
                                    <field name="close_notes" invisible="state != 'closed'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Términos y Notas" name="notes">
                            <field name="notes" placeholder="Términos particulares, SLA o notas de facturación..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Pivot View (Análisis de MRR y ARR) -->
    <record id="view_dolan_subscription_pivot" model="ir.ui.view">
        <field name="name">dolan.subscription.pivot</field>
        <field name="model">dolan.subscription</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de MRR y ARR" sample="1">
                <field name="plan_id" type="row"/>
                <field name="state" type="col"/>
                <field name="mrr" type="measure"/>
                <field name="arr" type="measure"/>
                <field name="recurring_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View (Gráfico de MRR) -->
    <record id="view_dolan_subscription_graph" model="ir.ui.view">
        <field name="name">dolan.subscription.graph</field>
        <field name="model">dolan.subscription</field>
        <field name="arch" type="xml">
            <graph string="Evolución y Distribución de MRR" type="bar" sample="1">
                <field name="plan_id"/>
                <field name="state"/>
                <field name="mrr" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- VISTAS DE PLANES DE RECURRENCIA (dolan.subscription.plan) -->
    <!-- ========================================================= -->

    <record id="view_dolan_subscription_plan_list" model="ir.ui.view">
        <field name="name">dolan.subscription.plan.list</field>
        <field name="model">dolan.subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Planes de Suscripción">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="code"/>
                <field name="billing_period"/>
                <field name="billing_interval_months"/>
                <field name="auto_renew"/>
                <field name="auto_send_email"/>
                <field name="subscription_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_subscription_plan_form" model="ir.ui.view">
        <field name="name">dolan.subscription.plan.form</field>
        <field name="model">dolan.subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de Suscripción">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej. Plan Mensual Pro"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Periodicidad">
                            <field name="code"/>
                            <field name="billing_period"/>
                            <field name="billing_interval_months" readonly="1"/>
                            <field name="mrr_factor" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Automatización de Facturación">
                            <field name="auto_renew"/>
                            <field name="auto_post_invoice"/>
                            <field name="auto_send_email"/>
                            <field name="grace_period_days"/>
                            <field name="journal_id"/>
                            <field name="payment_term_id"/>
                        </group>
                    </group>
                    <group string="Descripción y Condiciones">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- VISTAS DE MOTIVOS DE BAJA (dolan.subscription.close.reason)-->
    <!-- ========================================================= -->

    <record id="view_dolan_subscription_close_reason_list" model="ir.ui.view">
        <field name="name">dolan.subscription.close.reason.list</field>
        <field name="model">dolan.subscription.close.reason</field>
        <field name="arch" type="xml">
            <list string="Motivos de Baja" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_churn"/>
                <field name="retention_message"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- ACCIONES Y MENÚ RAÍZ SUSCRIPCIONES (sequence="40")        -->
    <!-- ========================================================= -->

    <record id="action_dolan_subscription" model="ir.actions.act_window">
        <field name="name">Suscripciones</field>
        <field name="res_model">dolan.subscription</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_dolan_subscription_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creá tu primer contrato de suscripción recurrente
            </p>
            <p>
                Gestioná abonos mensuales, bimestrales, trimestrales, semestrales o anuales,
                facturación recurrente automática y métricas de MRR/ARR en tiempo real.
            </p>
        </field>
    </record>

    <record id="action_dolan_subscription_mrr_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de MRR / ARR</field>
        <field name="res_model">dolan.subscription</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_dolan_subscription_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="action_dolan_subscription_plan" model="ir.actions.act_window">
        <field name="name">Planes de Recurrencia</field>
        <field name="res_model">dolan.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dolan_subscription_close_reason" model="ir.actions.act_window">
        <field name="name">Motivos de Baja (Churn)</field>
        <field name="res_model">dolan.subscription.close.reason</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menú Raíz: Suscripciones (sequence="40", espejo 1 a 1 de Odoo 20) -->
    <menuitem id="menu_dolan_subscription_root"
              name="Suscripciones"
              sequence="40"
              web_icon="DOLAN_subscription,static/description/icon.svg"
              groups="sales_team.group_sale_salesman"/>

    <!-- 1. Suscripciones -->
    <menuitem id="menu_dolan_subscription_main"
              name="Suscripciones"
              parent="menu_dolan_subscription_root"
              sequence="10"/>

    <menuitem id="menu_dolan_subscription_contracts"
              name="Suscripciones"
              parent="menu_dolan_subscription_main"
              action="action_dolan_subscription"
              sequence="10"/>

    <menuitem id="menu_dolan_subscription_quotations"
              name="Cotizaciones"
              parent="menu_dolan_subscription_main"
              action="sale.action_quotations_with_onboarding"
              sequence="20"/>

    <menuitem id="menu_dolan_subscription_to_renew"
              name="Por renovar"
              parent="menu_dolan_subscription_main"
              action="action_dolan_subscription"
              sequence="30"/>

    <menuitem id="menu_dolan_subscription_customers"
              name="Clientes"
              parent="menu_dolan_subscription_main"
              action="account.res_partner_action_customer"
              sequence="50"/>

    <!-- 2. Productos -->
    <menuitem id="menu_dolan_subscription_products_root"
              name="Productos"
              parent="menu_dolan_subscription_root"
              sequence="20"/>

    <menuitem id="menu_dolan_subscription_products"
              name="Productos"
              parent="menu_dolan_subscription_products_root"
              action="sale.product_template_action"
              sequence="10"/>

    <menuitem id="menu_dolan_subscription_pricelists"
              name="Listas de precios"
              parent="menu_dolan_subscription_products_root"
              action="product.product_pricelist_action2"
              sequence="20"/>

    <!-- 3. Informes -->
    <menuitem id="menu_dolan_subscription_reporting_root"
              name="Informes"
              parent="menu_dolan_subscription_root"
              sequence="30"/>

    <menuitem id="menu_dolan_subscription_reporting"
              name="Suscripciones y Desglose de MRR"
              parent="menu_dolan_subscription_reporting_root"
              action="action_dolan_subscription_mrr_analysis"
              sequence="10"/>

    <menuitem id="menu_dolan_subscription_retention"
              name="Retención y Churn"
              parent="menu_dolan_subscription_reporting_root"
              action="action_dolan_subscription_mrr_analysis"
              sequence="20"/>

    <!-- 4. Configuración -->
    <menuitem id="menu_dolan_subscription_config"
              name="Configuración"
              parent="menu_dolan_subscription_root"
              sequence="90"
              groups="sales_team.group_sale_manager"/>

    <menuitem id="menu_dolan_subscription_plans"
              name="Planes recurrentes"
              parent="menu_dolan_subscription_config"
              action="action_dolan_subscription_plan"
              sequence="10"/>

    <menuitem id="menu_dolan_subscription_close_reasons"
              name="Motivos de cierre"
              parent="menu_dolan_subscription_config"
              action="action_dolan_subscription_close_reason"
              sequence="20"/>
</odoo>
