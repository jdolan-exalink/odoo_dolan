<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_vacation_generate_form" model="ir.ui.view">
        <field name="name">dolan.hr.vacation.generate.form</field>
        <field name="model">dolan.hr.vacation.generate</field>
        <field name="arch" type="xml">
            <form string="Generar vacaciones del año">
                <group>
                    <group>
                        <field name="year" options="{'format': false}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="work_entry_type_id"/>
                        <field name="department_id"/>
                    </group>
                </group>
                <field name="employee_ids" widget="many2many_tags"/>
                <separator string="Vista previa"/>
                <field name="preview" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_generate" type="object" string="Generar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_vacation_generate" model="ir.actions.act_window">
        <field name="name">Generar vacaciones del año</field>
        <field name="res_model">dolan.hr.vacation.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
