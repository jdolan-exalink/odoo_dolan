<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_dolan_leave" model="ir.ui.view">
        <field name="name">hr.leave.form.dolan.leave</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <div name="warning_wrong_company" position="after">
                <div class="alert alert-warning" role="alert" invisible="not dolan_coverage_warning">
                    <field name="dolan_coverage_warning" readonly="1"/>
                </div>
            </div>
        </field>
    </record>

    <record id="hr_leave_allocation_view_tree_dolan_leave" model="ir.ui.view">
        <field name="name">hr.leave.allocation.list.dolan.leave</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="dolan_vacation_year" optional="show"/>
                <field name="dolan_vacation_note" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="hr_leave_allocation_view_form_dolan_leave" model="ir.ui.view">
        <field name="name">hr.leave.allocation.form.dolan.leave</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form"/>
        <field name="arch" type="xml">
            <field name="notes" position="before">
                <group invisible="not dolan_vacation_year">
                    <field name="dolan_vacation_year" readonly="1"/>
                    <field name="dolan_vacation_note" readonly="1"/>
                </group>
            </field>
        </field>
    </record>
</odoo>
