<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sueldos es un permiso explícito, independiente de Empleados: un Oficial
         o Responsable de Empleados no ve básicos, recibos ni liquidaciones si
         no tiene además uno de estos grupos (PRD Personal §7). -->
    <record id="res_groups_privilege_dolan_payroll" model="res.groups.privilege">
        <field name="name">Sueldos (DOLAN)</field>
        <field name="sequence">11</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_dolan_payroll_user" model="res.groups">
        <field name="name">Liquidación de sueldos</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_payroll"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Ve y liquida sueldos, recibos y exportaciones de las compañías permitidas.</field>
    </record>

    <record id="group_dolan_payroll_manager" model="res.groups">
        <field name="name">Responsable de sueldos</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_dolan_payroll_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Además configura convenios, conceptos, parámetros legales y la contabilización de sueldos.</field>
    </record>
</odoo>
