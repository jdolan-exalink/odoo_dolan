        <!-- Conceptos -->
        <record id="concept_basico" model="dolan.payroll.concept">
            <field name="name">Sueldo básico</field>
            <field name="code">BASICO</field>
            <field name="sequence">10</field>
            <field name="kind">rem</field>
            <field name="formula">basic * (worked_days - inp('VACDIAS') - inp('AUSINJ')) / 30.0</field>
            <field name="quantity_formula">worked_days - inp('VACDIAS') - inp('AUSINJ')</field>
            <field name="in_monthly" eval="True"/>
            <field name="in_sac" eval="False"/>
            <field name="in_final" eval="True"/>
            <field name="sac_base" eval="True"/>
            <field name="sicoss_bucket">sueldo</field>
            <field name="afip_code">1000</field>
        </record>
        <record id="concept_antig" model="dolan.payroll.concept">
            <field name="name">Antigüedad</field>
            <field name="code">ANTIG</field>
            <field name="sequence">20</field>
            <field name="kind">rem</field>
            <field name="formula">rules.get('BASICO', 0.0) * agreement.seniority_rate * years / 100.0</field>
            <field name="quantity_formula">years</field>
            <field name="condition">agreement.seniority_rate and years</field>
            <field name="in_monthly" eval="True"/>
            <field name="in_sac" eval="False"/>
            <field name="in_final" eval="True"/>
            <field name="sac_base" eval="True"/>
            <field name="sicoss_bucket">sueldo</field>
            <field name="afip_code">1010</field>
        </record>
        <record id="concept_present" model="dolan.payroll.concept">
            <field name="name">Presentismo</field>
            <field name="code">PRESENT</field>
            <field name="sequence">30</field>
            <field name="kind">rem</field>
            <field name="formula">(rules.get('BASICO', 0.0) + rules.get('ANTIG', 0.0)) * agreement.attendance_rate / 100.0</field>
            <field name="quantity_formula">agreement.attendance_rate</field>
            <field name="condition">agreement.attendance_rate and not inp('AUSINJ')</field>
            <field name="in_monthly" eval="True"/>
            <field name="in_sac" eval="False"/>
            <field name="in_final" eval="True"/>
            <field name="sac_base" eval="True"/>
            <field name="sicoss_bucket">adic</field>
            <field name="afip_code">1020</field>
        </record>
        <record id="concept_he50" model="dolan.payroll.concept">
            <field name="name">Horas extra al 50 %</field>
            <field name="code">HE50</field>
            <field name="sequence">40</field>
            <field name="kind">rem</field>
            <field name="formula">hour_value * 1.5 * inp('HE50')</field>
