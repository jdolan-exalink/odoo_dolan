<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_payroll_slip_search" model="ir.ui.view">
        <field name="name">dolan.payroll.slip.search</field>
        <field name="model">dolan.payroll.slip</field>
        <field name="arch" type="xml">
            <search string="Recibos">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="run_id"/>
                <filter string="Confirmados" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Firma pendiente" name="sign_pending"
                        domain="[('state', '=', 'done'), ('employee_sign_state', '=', 'pending')]"/>
                <group>
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Período" name="group_period" context="{'group_by': 'date_to:month'}"/>
                    <filter string="Tipo" name="group_kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dolan_payroll_slip_list" model="ir.ui.view">
        <field name="name">dolan.payroll.slip.list</field>
        <field name="model">dolan.payroll.slip</field>
        <field name="arch" type="xml">
            <list string="Recibos" decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="kind"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_rem" sum="Total" optional="show"/>
                <field name="total_norem" sum="Total" optional="hide"/>
                <field name="total_ded" sum="Total" optional="show"/>
                <field name="net" sum="Total"/>
                <field name="employee_sign_state" widget="badge"
                       decoration-success="employee_sign_state == 'signed'"
                       decoration-warning="employee_sign_state == 'disagreement'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'" decoration-info="state == 'computed'"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_payroll_slip_form" model="ir.ui.view">
        <field name="name">dolan.payroll.slip.form</field>
        <field name="model">dolan.payroll.slip</field>
        <field name="arch" type="xml">
            <form string="Recibo de haberes">
                <header>
                    <button name="action_compute" type="object" string="Calcular" class="btn-primary"
                            invisible="state not in ('draft', 'computed')" groups="DOLAN_payroll_ar.group_dolan_payroll_user"/>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"
                            invisible="state != 'computed'" groups="DOLAN_payroll_ar.group_dolan_payroll_user"/>
                    <button name="action_employee_sign" type="object" string="Firmar en conformidad"
                            class="btn-primary"
                            invisible="state != 'done' or employee_sign_state != 'pending'"/>
                    <button name="action_employee_sign_disagreement" type="object"
                            string="Firmar en disconformidad"
                            invisible="state != 'done' or employee_sign_state != 'pending'"/>
                    <button name="action_verify_signature" type="object" string="Verificar huella"
                            invisible="state != 'done'"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state not in ('computed', 'done', 'cancel')" groups="DOLAN_payroll_ar.group_dolan_payroll_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="run_id" readonly="1"/>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state not in ('draft', 'computed')"/>
                            <field name="date_to" readonly="state not in ('draft', 'computed')"/>
                            <field name="payment_date" readonly="state == 'done'"/>
                            <field name="worked_days" readonly="state not in ('draft', 'computed')"/>
                        </group>
                        <group string="Egreso" invisible="kind != 'final'">
                            <field name="termination_date" readonly="state == 'done'"/>
                            <field name="termination_reason" readonly="state == 'done'"/>
                            <field name="notice_given" readonly="state == 'done'"/>
                        </group>
                        <group string="Datos liquidados">
                            <field name="agreement_id"/>
                            <field name="category_id"/>
                            <field name="basic"/>
                            <field name="seniority_years"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conceptos" name="lines">
                            <field name="line_ids">
                                <list decoration-danger="kind == 'ded'" decoration-muted="kind == 'contrib'">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="quantity"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_rem"/>
                                <field name="total_norem"/>
                                <field name="total_ded"/>
                                <field name="net" class="oe_subtotal_footer_separator"/>
                                <field name="total_contrib"/>
                            </group>
                        </page>
                        <page string="Novedades" name="inputs">
                            <field name="input_ids" readonly="state not in ('draft', 'computed')">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Firma" name="signature">
                            <group>
                                <field name="employer_hash"/>
                                <field name="employee_sign_state"/>
                                <field name="employee_sign_date"/>
                                <field name="employee_sign_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dolan_payroll_slip" model="ir.actions.act_window">
        <field name="name">Recibos</field>
        <field name="res_model">dolan.payroll.slip</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dolan_payroll_my_slips" model="ir.actions.act_window">
        <field name="name">Mis recibos</field>
        <field name="res_model">dolan.payroll.slip</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid), ('state', '=', 'done')]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
</odoo>
