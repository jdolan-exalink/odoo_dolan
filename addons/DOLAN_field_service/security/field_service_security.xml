<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dolan_field_service" model="ir.module.category">
        <field name="name">Servicios (DOLAN): órdenes de servicio</field>
        <field name="sequence">42</field>
    </record>
    <record id="res_groups_privilege_dolan_field_service" model="res.groups.privilege">
        <field name="name">Órdenes de servicio</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_dolan_field_service"/>
    </record>
    <record id="group_field_service_technician" model="res.groups">
        <field name="name">Técnico</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_field_service"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ve y trabaja sus órdenes: carga horas, materiales y la conformidad del cliente.</field>
    </record>
    <record id="group_field_service_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_field_service"/>
        <field name="implied_ids" eval="[(4, ref('group_field_service_technician')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Crea y asigna órdenes de todos los técnicos y las factura.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_field_service_manager'))]"/>
    </record>
</odoo>
