<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dolan_service_order" model="ir.sequence">
            <field name="name">Órdenes de servicio</field>
            <field name="code">dolan.service.order</field>
            <field name="prefix">OS-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="product_labor_hour" model="product.product">
            <field name="name">Mano de obra (hora)</field>
            <field name="type">service</field>
            <field name="list_price">0</field>
            <field name="sale_ok" eval="True"/>
        </record>
    </data>
</odoo>
