<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dolan_credit_limit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dolan.credit.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_default_credit_limit']/.." position="after">
                <div class="row mt-2">
                    <label for="dolan_credit_limit_mode" class="col-lg-4 o_light_label"/>
                    <field name="dolan_credit_limit_mode" widget="radio" options="{'horizontal': True}"/>
                </div>
                <div class="row mt-2">
                    <label for="dolan_credit_include_checks" class="col-lg-4 o_light_label"/>
                    <field name="dolan_credit_include_checks"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
