<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_overtime_list" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.list</field>
        <field name="model">dolan.hr.overtime</field>
        <field name="arch" type="xml">
            <list string="Horas extra" create="0" delete="0"
                  decoration-muted="state in ('cancelled', 'rejected')" decoration-warning="state in ('detected', 'pending')">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="hide"/>
                <field name="registered_minutes" sum="Total"/>
                <field name="regular_minutes" optional="show" sum="Total"/>
                <field name="rest_minutes" optional="show" sum="Total"/>
                <field name="requested_minutes" optional="show"/>
                <field name="approved_minutes" optional="show" sum="Total"/>
                <field name="payable_minutes" sum="Total"/>
                <field name="cap_note" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_overtime_form" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.form</field>
        <field name="model">dolan.hr.overtime</field>
        <field name="arch" type="xml">
            <form string="Horas extra" create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary"
                            invisible="state not in ('detected', 'pending')"
                            groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state not in ('detected', 'pending')"
                            groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <button name="action_reset" type="object" string="Volver a revisar"
                            invisible="state not in ('approved', 'rejected')"
                            groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <field name="state" widget="statusbar" statusbar_visible="detected,pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Registradas">
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="registered_minutes"/>
                            <field name="regular_minutes"/>
                            <field name="rest_minutes"/>
                            <field name="night_minutes"/>
                            <field name="incident_id"/>
                        </group>
                        <group string="Autorizadas y liquidables">
                            <field name="request_id"/>
                            <field name="requested_minutes"/>
                            <field name="authorization_note" readonly="state not in ('detected', 'pending')"
                                   invisible="request_id"/>
                            <field name="approved_minutes"/>
                            <field name="payable_minutes"/>
                            <field name="payable_regular_minutes"/>
                            <field name="payable_rest_minutes"/>
                            <field name="cap_note" invisible="not cap_note"/>
                            <field name="decided_by" invisible="not decided_by"/>
                            <field name="decided_on" invisible="not decided_on"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dolan_hr_overtime_search" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.search</field>
        <field name="model">dolan.hr.overtime</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="to_review" string="Para decidir" domain="[('state', 'in', ('detected', 'pending'))]"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="no_request" string="Sin autorización previa" domain="[('request_id', '=', False)]"/>
                <filter name="date" string="Fecha" date="date"/>
                <group>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_hr_overtime" model="ir.actions.act_window">
        <field name="name">Horas extra</field>
        <field name="res_model">dolan.hr.overtime</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_review': 1}</field>
    </record>

    <record id="view_dolan_hr_overtime_request_list" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.request.list</field>
        <field name="model">dolan.hr.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Autorizaciones de horas extra">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="hours" widget="float_time"/>
                <field name="reason"/>
                <field name="requested_by" optional="show"/>
                <field name="approved_by" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_overtime_request_form" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.request.form</field>
        <field name="model">dolan.hr.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Autorización de horas extra">
                <header>
                    <button name="action_approve" type="object" string="Autorizar" class="btn-primary"
                            invisible="state != 'draft'" groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'draft'" groups="DOLAN_hr_core.group_dolan_hr_supervisor"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="hours" widget="float_time" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="approved_by" invisible="not approved_by"/>
                            <field name="approved_on" invisible="not approved_on"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Motivo (por ejemplo: cierre de inventario)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_overtime_request" model="ir.actions.act_window">
        <field name="name">Autorizaciones de horas extra</field>
        <field name="res_model">dolan.hr.overtime.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dolan_hr_overtime_rule_list" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.rule.list</field>
        <field name="model">dolan.hr.overtime.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de horas extra" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="rate_percent"/>
                <field name="input_code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_hr_overtime_rule" model="ir.actions.act_window">
        <field name="name">Reglas de horas extra</field>
        <field name="res_model">dolan.hr.overtime.rule</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
