<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_marketplace_log_list" model="ir.ui.view">
        <field name="name">dolan.marketplace.log.list</field>
        <field name="model">dolan.marketplace.log</field>
        <field name="arch" type="xml">
            <list string="Registro de marketplaces" create="false" edit="false" decoration-danger="state == 'error'">
                <field name="create_date" string="Fecha"/>
                <field name="account_id"/>
                <field name="operation"/>
                <field name="reference"/>
                <field name="message"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_marketplace_log_search" model="ir.ui.view">
        <field name="name">dolan.marketplace.log.search</field>
        <field name="model">dolan.marketplace.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="message"/>
                <field name="account_id"/>
                <filter string="Errores" name="errors" domain="[('state', '=', 'error')]"/>
                <group>
                    <filter string="Cuenta" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Operación" name="group_operation" context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_marketplace_log" model="ir.actions.act_window">
        <field name="name">Registro de sincronización</field>
        <field name="res_model">dolan.marketplace.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
