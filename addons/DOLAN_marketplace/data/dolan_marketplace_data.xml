<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_dolan_marketplace_orders" model="ir.cron">
        <field name="name">Marketplaces: bajar ventas</field>
        <field name="model_id" ref="model_dolan_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_orders()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_dolan_marketplace_listings" model="ir.cron">
        <field name="name">Marketplaces: sincronizar stock y precios</field>
        <field name="model_id" ref="model_dolan_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_listings()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
