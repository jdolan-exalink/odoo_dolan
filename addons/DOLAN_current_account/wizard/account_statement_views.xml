<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_account_statement_wizard_form" model="ir.ui.view">
        <field name="name">dolan.account.statement.wizard.form</field>
        <field name="model">dolan.account.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Estado de cuenta">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="kind" widget="radio" options="{'horizontal': true}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_open"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="PDF" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Excel"/>
                    <button name="action_send_email" type="object" string="Enviar por correo"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dolan_account_statement_wizard" model="ir.actions.act_window">
        <field name="name">Estado de cuenta</field>
        <field name="res_model">dolan.account.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
