<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_scale_management" model="ir.module.category">
        <field name="name">Administración de balanzas</field>
        <field name="sequence">38</field>
    </record>

    <record id="privilege_scale_management" model="res.groups.privilege">
        <field name="name">Balanzas</field>
        <field name="category_id" ref="module_category_scale_management"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_scale_operator" model="res.groups">
        <field name="name">Operador de balanzas</field>
        <field name="privilege_id" ref="privilege_scale_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_scale_branch_manager" model="res.groups">
        <field name="name">Responsable de sucursal (balanzas)</field>
        <field name="privilege_id" ref="privilege_scale_management"/>
        <field name="implied_ids" eval="[(4, ref('group_scale_operator'))]"/>
    </record>
    <record id="group_scale_admin" model="res.groups">
        <field name="name">Administrador de balanzas</field>
        <field name="privilege_id" ref="privilege_scale_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_scale_auditor" model="res.groups">
        <field name="name">Auditor de balanzas</field>
        <field name="privilege_id" ref="privilege_scale_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Odoo system administrators can configure this app immediately after install. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_scale_admin'))]"/>
    </record>
</odoo>
