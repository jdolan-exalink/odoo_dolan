    <!-- Odoo 20 uses ir.access records instead of the legacy ir.model.access CSV format. -->
    <record id="access_scale_device_admin" model="ir.access">
        <field name="name">scale.device admin</field><field name="model_id" ref="model_scale_device"/>
        <field name="group_id" ref="group_scale_admin"/><field name="operation">cru</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
