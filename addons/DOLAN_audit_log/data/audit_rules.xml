<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_partner_tax" model="dolan.audit.rule">
            <field name="name">CUIT de contactos</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="field_ids" eval="[(6, 0, [ref('base.field_res_partner__vat')])]"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_partner_bank" model="dolan.audit.rule">
            <field name="name">Cuentas bancarias</field>
            <field name="model_id" ref="base.model_res_partner_bank"/>
            <field name="field_ids" eval="[(6, 0, [ref('base.field_res_partner_bank__account_number'), ref('base.field_res_partner_bank__bank_name'), ref('base.field_res_partner_bank__holder_name'), ref('base.field_res_partner_bank__partner_id')])]"/>
            <field name="log_create" eval="True"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_product_price" model="dolan.audit.rule">
            <field name="name">Precio y costo de productos</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="field_ids" eval="[(6, 0, [ref('product.field_product_template__list_price'), ref('product.field_product_template__standard_price')])]"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_pricelist_item" model="dolan.audit.rule">
            <field name="name">Ítems de listas de precios</field>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name="field_ids" eval="[(6, 0, [ref('product.field_product_pricelist_item__fixed_price'), ref('product.field_product_pricelist_item__price_discount')])]"/>
            <field name="log_create" eval="True"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_move_state" model="dolan.audit.rule">
            <field name="name">Anulación y vuelta a borrador de comprobantes</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="field_ids" eval="[(6, 0, [ref('account.field_account_move__state')])]"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_payment" model="dolan.audit.rule">
            <field name="name">Pagos y cobros</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="field_ids" eval="[(6, 0, [ref('account.field_account_payment__amount'), ref('account.field_account_payment__state'), ref('account.field_account_payment__partner_id')])]"/>
            <field name="log_create" eval="True"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_reconcile" model="dolan.audit.rule">
            <field name="name">Conciliaciones</field>
            <field name="model_id" ref="account.model_account_partial_reconcile"/>
            <field name="field_ids" eval="[(6, 0, [ref('account.field_account_partial_reconcile__amount'), ref('account.field_account_partial_reconcile__debit_move_id'), ref('account.field_account_partial_reconcile__credit_move_id')])]"/>
            <field name="log_create" eval="True"/>
            <field name="log_unlink" eval="True"/>
        </record>
        <record id="rule_users" model="dolan.audit.rule">
            <field name="name">Usuarios y permisos</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="field_ids" eval="[(6, 0, [ref('base.field_res_users__group_ids'), ref('base.field_res_users__login'), ref('base.field_res_users__active')])]"/>
            <field name="log_create" eval="True"/>
            <field name="log_unlink" eval="True"/>
        </record>
    </data>
</odoo>
