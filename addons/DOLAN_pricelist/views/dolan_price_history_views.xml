<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_price_history_list" model="ir.ui.view">
        <field name="name">dolan.price.history.list</field>
        <field name="model">dolan.price.history</field>
        <field name="arch" type="xml">
            <list string="Historial de precios" create="false" edit="false" delete="false">
                <field name="change_date"/>
                <field name="product_tmpl_id"/>
                <field name="price_type"/>
                <field name="pricelist_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="old_price" widget="monetary"/>
                <field name="new_price" widget="monetary"/>
                <field name="variation_pct"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="origin" optional="show"/>
                <field name="update_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_price_history_graph" model="ir.ui.view">
        <field name="name">dolan.price.history.graph</field>
        <field name="model">dolan.price.history</field>
        <field name="arch" type="xml">
            <graph string="Evolución de precios" type="line">
                <field name="change_date" interval="day"/>
                <field name="new_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dolan_price_history_pivot" model="ir.ui.view">
        <field name="name">dolan.price.history.pivot</field>
        <field name="model">dolan.price.history</field>
        <field name="arch" type="xml">
            <pivot string="Historial de precios">
                <field name="product_tmpl_id" type="row"/>
                <field name="change_date" interval="month" type="col"/>
                <field name="variation_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dolan_price_history_search" model="ir.ui.view">
        <field name="name">dolan.price.history.search</field>
        <field name="model">dolan.price.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="update_id"/>
                <field name="user_id"/>
                <filter string="Precio de venta" name="list_price" domain="[('price_type', '=', 'list_price')]"/>
                <filter string="Costo" name="standard_price" domain="[('price_type', '=', 'standard_price')]"/>
                <filter string="Listas de precios" name="pricelist" domain="[('price_type', '=', 'pricelist')]"/>
                <filter string="Fecha" name="change_date" date="change_date"/>
                <group>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'price_type'}"/>
                    <filter string="Lote" name="group_update" context="{'group_by': 'update_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_price_history" model="ir.actions.act_window">
        <field name="name">Historial de precios</field>
        <field name="res_model">dolan.price.history</field>
        <field name="view_mode">list,graph,pivot</field>
    </record>
</odoo>
