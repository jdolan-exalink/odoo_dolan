        <field name="code">model._cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_dolan_discount_cleanup_employee_claims" model="ir.cron">
        <field name="name">DOLAN: limpiar beneficios de empleado vencidos</field>
        <field name="model_id" ref="model_dolan_discount_employee_claim"/>
        <field name="state">code</field>
        <field name="code">model._cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
