<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="pos_orderline_receipt_dolan_promotions" inherit_id="point_of_sale.pos_orderline_receipt_information">
        <xpath expr="//div[@name='extra-info']" position="before">
            <div t-foreach="line.get('dolan_promotions', [])" t-as="promotion" class="text-small dolan-receipt-promotion">
                <span t-out="promotion['label']"/> · Ahorro <span t-out="promotion['amount']"/>
            </div>
        </xpath>
    </template>
</odoo>
