<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_config_dolan_discount_form" model="ir.ui.view">
        <field name="name">pos.config.dolan.discount.form</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="dolan_discount_policy" string="Límite de descuentos manuales" help="Cero bloquea el descuento manual de cajeros. Se exige motivo; los excesos requieren autorización de un supervisor.">
                    <field name="dolan_discount_cashier_limit"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
