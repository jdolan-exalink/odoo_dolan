<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dolan_discount_simulator_form" model="ir.ui.view">
        <field name="name">dolan.discount.simulator.form</field><field name="model">dolan.discount.simulator</field>
        <field name="arch" type="xml"><form string="Simular promoción"><group>
            <field name="company_id"/><field name="pos_config_id"/><field name="at"/>
            <field name="product_id"/><field name="quantity"/><field name="unit_price"/><field name="payment_method_id"/>
        </group><group><field name="result" nolabel="1" widget="text" readonly="1"/></group><footer>
            <button name="action_simulate" type="object" string="Calcular" class="btn-primary"/>
            <button string="Cerrar" special="cancel" class="btn-secondary"/>
        </footer></form></field>
    </record>
    <record id="action_dolan_discount_simulator" model="ir.actions.act_window">
        <field name="name">Simulador de promociones</field><field name="res_model">dolan.discount.simulator</field><field name="view_mode">form</field><field name="view_id" ref="view_dolan_discount_simulator_form"/><field name="target">new</field>
    </record>
    <record id="view_dolan_discount_alert_list" model="ir.ui.view">
        <field name="name">dolan.discount.alert.list</field><field name="model">dolan.discount.alert</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'" decoration-success="state == 'resolved'">
            <field name="create_date"/><field name="severity"/><field name="category"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="campaign_id"/><field name="order_id"/><field name="actor_id"/><field name="state"/>
        </list></field>
    </record>
    <record id="view_dolan_discount_alert_form" model="ir.ui.view">
        <field name="name">dolan.discount.alert.form</field><field name="model">dolan.discount.alert</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group>
            <field name="name"/><field name="severity"/><field name="category"/><field name="state"/><field name="company_id"/><field name="campaign_id"/><field name="order_id"/><field name="order_line_id"/><field name="actor_id"/><field name="detail"/><field name="snapshot"/><field name="resolution"/><field name="resolved_by_id"/><field name="resolved_at"/>
        </group></sheet></form></field>
    </record>
    <record id="action_dolan_discount_alert" model="ir.actions.act_window">
        <field name="name">Alertas</field><field name="res_model">dolan.discount.alert</field><field name="view_mode">list,form</field>
    </record>
</odoo>
