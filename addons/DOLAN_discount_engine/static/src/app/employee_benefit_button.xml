<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button class="btn btn-secondary btn-lg lh-lg dolan-employee-benefit-button"
                    t-on-click="this.clickDolanEmployeeBenefit"
                    t-att-disabled="!this.currentOrder || this.currentOrder.isEmpty()">
                <i class="fa fa-id-card-o me-1" aria-hidden="true"/>
                <span>Beneficio empleado</span>
            </button>
        </xpath>
    </t>
</templates>
