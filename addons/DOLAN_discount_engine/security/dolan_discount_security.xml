<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_discount_manager" model="res.groups">
        <field name="name">Administrador comercial de promociones</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_discount_supervisor" model="res.groups">
        <field name="name">Supervisor de descuentos</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_discount_cashier" model="res.groups">
        <field name="name">Cajero con descuentos</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_discount_auditor" model="res.groups">
        <field name="name">Auditor de promociones</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_discount_manager'))]"/>
    </record>
</odoo>
