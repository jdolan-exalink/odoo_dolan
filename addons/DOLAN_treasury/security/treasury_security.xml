<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_dolan_treasury" model="res.groups.privilege">
        <field name="name">Caja y Tesorería</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_treasury_cashier" model="res.groups">
        <field name="name">Cajero</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_treasury"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Abre y cierra sus turnos en las cajas que tiene asignadas, registra movimientos y hace el arqueo.</field>
    </record>
    <record id="group_treasury_manager" model="res.groups">
        <field name="name">Tesorero</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_cashier'))]"/>
        <field name="comment">Configura cajas, ve todos los turnos y aprueba diferencias de arqueo.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_treasury_manager'))]"/>
    </record>
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_treasury_manager'))]"/>
    </record>
</odoo>
