<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">dolan.helpdesk.ticket.form</field>
        <field name="model">dolan.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <button name="action_assign_to_me" type="object" string="Tomar" invisible="user_id"/>
                    <button name="action_whatsapp_notify" type="object" string="Avisar por WhatsApp" invisible="not partner_id"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Cerrado" invisible="not is_closed"/>
                    <div class="oe_title">
                        <field name="number" readonly="1" class="text-muted" invisible="number == '/'"/>
                        <h1><field name="name" placeholder="Asunto del ticket"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_email" widget="email"/>
                            <field name="partner_phone" widget="phone"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_closed" invisible="1"/>
                        </group>
                    </group>
                    <group string="SLA" invisible="sla_status == 'none'">
                        <group>
                            <field name="sla_id"/>
                            <field name="sla_deadline"/>
                        </group>
                        <group>
                            <field name="sla_status" widget="badge"
                                   decoration-success="sla_status in ('ok', 'reached')"
                                   decoration-warning="sla_status == 'at_risk'"
                                   decoration-danger="sla_status == 'failed'"/>
                            <field name="date_closed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" placeholder="Qué pasa, desde cuándo, qué se probó…"/>
                        </page>
                        <page string="Solución" name="solution">
                            <field name="close_reason" placeholder="Qué se hizo para resolverlo. Es obligatorio para cerrar."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dolan_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">dolan.helpdesk.ticket.list</field>
        <field name="model">dolan.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-danger="sla_status == 'failed'" decoration-warning="sla_status == 'at_risk'" decoration-muted="is_closed">
                <field name="number"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="stage_id"/>
                <field name="sla_deadline" optional="show"/>
                <field name="sla_status" widget="badge" optional="show"
                       decoration-success="sla_status in ('ok', 'reached')"
                       decoration-warning="sla_status == 'at_risk'"
                       decoration-danger="sla_status == 'failed'"/>
                <field name="channel" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="is_closed" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">dolan.helpdesk.ticket.kanban</field>
        <field name="model">dolan.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="sla_status"/>
                <field name="color"/>
                <progressbar field="sla_status" colors='{"ok": "success", "reached": "success", "at_risk": "warning", "failed": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="number" class="text-muted small"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <field name="name" class="fw-bold"/>
                        <field name="partner_id" class="small"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <footer>
                            <field name="sla_deadline" widget="remaining_days" invisible="not sla_deadline"/>
                            <field name="kanban_state" widget="state_selection" class="ms-auto"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dolan_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">dolan.helpdesk.ticket.search</field>
        <field name="model">dolan.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Ticket" filter_domain="['|', ('name', 'ilike', self), ('number', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="tag_ids"/>
                <filter name="mine" string="Mis tickets" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Sin asignar" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="open" string="Abiertos" domain="[('is_closed', '=', False)]"/>
                <filter name="closed" string="Cerrados" domain="[('is_closed', '=', True)]"/>
                <separator/>
                <filter name="sla_at_risk" string="SLA en riesgo" domain="[('sla_status', '=', 'at_risk')]"/>
                <filter name="sla_failed" string="SLA vencido" domain="[('sla_status', '=', 'failed')]"/>
                <filter name="urgent" string="Urgentes" domain="[('priority', '=', '3')]"/>
                <group>
                    <filter name="group_team" string="Equipo" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Responsable" context="{'group_by': 'user_id'}"/>
                    <filter name="group_stage" string="Etapa" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_channel" string="Canal" context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dolan_helpdesk_ticket_pivot" model="ir.ui.view">
        <field name="name">dolan.helpdesk.ticket.pivot</field>
        <field name="model">dolan.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de tickets">
                <field name="team_id" type="row"/>
                <field name="sla_status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_dolan_helpdesk_ticket_graph" model="ir.ui.view">
        <field name="name">dolan.helpdesk.ticket.graph</field>
        <field name="model">dolan.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="Tickets por etapa" type="bar">
                <field name="stage_id"/>
            </graph>
        </field>
    </record>

    <record id="action_dolan_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">dolan.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form,pivot,graph,activity</field>
        <field name="search_view_id" ref="view_dolan_helpdesk_ticket_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay tickets</p>
            <p>Los tickets se crean a mano o solos, con cada correo que llega al alias del equipo.</p>
        </field>
    </record>

    <record id="action_dolan_helpdesk_ticket_analysis" model="ir.actions.act_window">
        <field name="name">Análisis</field>
        <field name="res_model">dolan.helpdesk.ticket</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_dolan_helpdesk_ticket_search"/>
    </record>
</odoo>
