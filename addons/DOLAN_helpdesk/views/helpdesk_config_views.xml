<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_helpdesk_team_kanban" model="ir.ui.view">
        <field name="name">dolan.helpdesk.team.kanban</field>
        <field name="model">dolan.helpdesk.team</field>
        <field name="arch" type="xml">
            <kanban action="action_open_tickets" type="object" create="false">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="company_id" class="text-muted small" groups="base.group_multi_company"/>
                        <div class="d-flex gap-3 mt-2">
                            <span><field name="open_ticket_count"/> abiertos</span>
                            <span class="text-danger"><field name="failed_ticket_count"/> con SLA vencido</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dolan_helpdesk_team_form" model="ir.ui.view">
        <field name="name">dolan.helpdesk.team.form</field>
        <field name="model">dolan.helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="open_ticket_count" widget="statinfo" string="Abiertos"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Nombre del equipo"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="resource_calendar_id"/>
                            <field name="assignment"/>
                        </group>
                        <group string="Correo entrante">
                            <label for="alias_name" string="Alias"/>
                            <div class="o_row">
                                <field name="alias_name" placeholder="soporte"/>@<field name="alias_domain_id" placeholder="dominio"/>
                            </div>
                            <field name="alias_contact"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Miembros" name="members">
                            <field name="member_ids" widget="many2many_tags_avatar"/>
                        </page>
                        <page string="Reglas de SLA" name="sla">
                            <field name="sla_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="priority"/>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="hours" widget="float_time"/>
                                    <field name="warning_ratio"/>
                                </list>
                            </field>
                        </page>
                        <page string="Etapas" name="stages">
                            <field name="stage_ids"/>
                            <p class="text-muted">Vacío: el equipo usa las etapas que no están asignadas a ningún equipo.</p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dolan_helpdesk_team_list" model="ir.ui.view">
        <field name="name">dolan.helpdesk.team.list</field>
        <field name="model">dolan.helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Equipos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="alias_name"/>
                <field name="assignment"/>
                <field name="open_ticket_count"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_helpdesk_team" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">dolan.helpdesk.team</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_dolan_helpdesk_stage_list" model="ir.ui.view">
        <field name="name">dolan.helpdesk.stage.list</field>
        <field name="model">dolan.helpdesk.stage</field>
        <field name="arch" type="xml">
            <list string="Etapas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_closed"/>
                <field name="fold"/>
                <field name="team_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_helpdesk_stage" model="ir.actions.act_window">
        <field name="name">Etapas</field>
        <field name="res_model">dolan.helpdesk.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_dolan_helpdesk_sla_list" model="ir.ui.view">
        <field name="name">dolan.helpdesk.sla.list</field>
        <field name="model">dolan.helpdesk.sla</field>
        <field name="arch" type="xml">
            <list string="Reglas de SLA" editable="bottom">
                <field name="team_id"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="hours" widget="float_time"/>
                <field name="warning_ratio"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_helpdesk_sla" model="ir.actions.act_window">
        <field name="name">Reglas de SLA</field>
        <field name="res_model">dolan.helpdesk.sla</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_dolan_helpdesk_tag_list" model="ir.ui.view">
        <field name="name">dolan.helpdesk.tag.list</field>
        <field name="model">dolan.helpdesk.tag</field>
        <field name="arch" type="xml">
            <list string="Etiquetas" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_helpdesk_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">dolan.helpdesk.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
