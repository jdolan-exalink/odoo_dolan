<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dolan_helpdesk_ticket" model="ir.sequence">
            <field name="name">Tickets de mesa de ayuda</field>
            <field name="code">dolan.helpdesk.ticket</field>
            <field name="prefix">TK-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_new" model="dolan.helpdesk.stage">
            <field name="name">Nuevo</field>
            <field name="sequence">1</field>
        </record>
        <record id="stage_in_progress" model="dolan.helpdesk.stage">
            <field name="name">En curso</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_waiting" model="dolan.helpdesk.stage">
            <field name="name">Esperando al cliente</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_solved" model="dolan.helpdesk.stage">
            <field name="name">Resuelto</field>
            <field name="sequence">30</field>
            <field name="is_closed" eval="True"/>
            <field name="fold" eval="True"/>
        </record>
        <record id="stage_cancelled" model="dolan.helpdesk.stage">
            <field name="name">Cancelado</field>
            <field name="sequence">40</field>
            <field name="is_closed" eval="True"/>
            <field name="fold" eval="True"/>
        </record>
        <record id="team_support" model="dolan.helpdesk.team">
            <field name="name">Soporte</field>
            <field name="alias_name">soporte</field>
        </record>
        <record id="sla_default" model="dolan.helpdesk.sla">
            <field name="name">Resolución en 2 días hábiles</field>
            <field name="team_id" ref="team_support"/>
            <field name="priority">0</field>
            <field name="hours">16</field>
        </record>
        <record id="sla_urgent" model="dolan.helpdesk.sla">
            <field name="name">Urgente: 4 horas hábiles</field>
            <field name="team_id" ref="team_support"/>
            <field name="priority">3</field>
            <field name="hours">4</field>
        </record>
    </data>
    <record id="ir_cron_dolan_helpdesk_sla" model="ir.cron">
        <field name="name">Mesa de ayuda: actualizar estado de SLA</field>
        <field name="model_id" ref="model_dolan_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_sla()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
