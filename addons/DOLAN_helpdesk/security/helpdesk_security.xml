<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dolan_services" model="ir.module.category">
        <field name="name">Servicios (DOLAN)</field>
        <field name="sequence">40</field>
    </record>
    <record id="res_groups_privilege_dolan_helpdesk" model="res.groups.privilege">
        <field name="name">Mesa de ayuda</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_dolan_services"/>
    </record>
    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Atiende tickets de las empresas a las que tiene acceso.</field>
    </record>
    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="comment">Además configura equipos, etapas y reglas de SLA, y puede borrar tickets.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_manager'))]"/>
    </record>
</odoo>
