<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_attendance_incident_pivot" model="ir.ui.view">
        <field name="name">dolan.hr.attendance.incident.pivot</field>
        <field name="model">dolan.hr.attendance.incident</field>
        <field name="arch" type="xml">
            <pivot string="Incidencias" sample="1">
                <field name="department_id" type="row"/>
                <field name="kind" type="col"/>
                <field name="minutes" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_dolan_hr_attendance_incident_graph" model="ir.ui.view">
        <field name="name">dolan.hr.attendance.incident.graph</field>
        <field name="model">dolan.hr.attendance.incident</field>
        <field name="arch" type="xml">
            <graph string="Incidencias" type="bar" stacked="1" sample="1">
                <field name="date" interval="week"/>
                <field name="kind"/>
            </graph>
        </field>
    </record>
    <record id="action_dolan_hr_report_incidents" model="ir.actions.act_window">
        <field name="name">Análisis de presentismo</field>
        <field name="res_model">dolan.hr.attendance.incident</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_active_ones': 1}</field>
    </record>

    <record id="view_dolan_hr_overtime_pivot" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.pivot</field>
        <field name="model">dolan.hr.overtime</field>
        <field name="arch" type="xml">
            <pivot string="Horas extra" sample="1">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="registered_minutes" type="measure"/>
                <field name="payable_minutes" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_dolan_hr_overtime_graph" model="ir.ui.view">
        <field name="name">dolan.hr.overtime.graph</field>
        <field name="model">dolan.hr.overtime</field>
        <field name="arch" type="xml">
            <graph string="Horas extra" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="payable_minutes" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_dolan_hr_report_overtime" model="ir.actions.act_window">
        <field name="name">Análisis de horas extra</field>
        <field name="res_model">dolan.hr.overtime</field>
        <field name="view_mode">pivot,graph,list,form</field>
    </record>

    <record id="view_dolan_hr_novelty_pivot" model="ir.ui.view">
        <field name="name">dolan.hr.novelty.pivot</field>
        <field name="model">dolan.hr.novelty</field>
        <field name="arch" type="xml">
            <pivot string="Novedades" sample="1">
                <field name="employee_id" type="row"/>
                <field name="code" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_dolan_hr_report_novelties" model="ir.actions.act_window">
        <field name="name">Novedades por empleado y período</field>
        <field name="res_model">dolan.hr.novelty</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="context">{'search_default_valid': 1, 'search_default_group_period': 1}</field>
    </record>
</odoo>
