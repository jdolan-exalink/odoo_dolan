<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_dolan_cot" model="ir.ui.view">
        <field name="name">product.template.form.dolan.cot</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="dolan_cot_code" invisible="type != 'consu'"/>
            </field>
        </field>
    </record>

    <record id="uom_list_dolan_cot" model="ir.ui.view">
        <field name="name">uom.uom.list.dolan.cot</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dolan_cot_uom_code" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
