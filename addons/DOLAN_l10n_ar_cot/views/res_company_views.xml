<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_dolan_cot" model="ir.ui.view">
        <field name="name">res.company.form.dolan.cot</field>
        <field name="model">res.company</field>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <form string="COT ARBA" create="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Acceso a ARBA">
                            <field name="dolan_cot_enabled"/>
                            <field name="dolan_cot_environment"/>
                            <field name="dolan_cot_user"/>
                            <field name="dolan_cot_password" password="True"/>
                            <field name="dolan_cot_plant"/>
                        </group>
                        <group string="Reglas">
                            <field name="currency_id" invisible="1"/>
                            <field name="dolan_cot_min_amount"/>
                            <field name="dolan_cot_auto"/>
                            <field name="dolan_cot_file_sequence" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dolan_cot_company_settings" model="ir.actions.server">
        <field name="name">COT ARBA</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'COT ARBA',
    'res_model': 'res.company',
    'res_id': env.company.id,
    'view_mode': 'form',
    'views': [(env.ref('DOLAN_l10n_ar_cot.view_company_form_dolan_cot').id, 'form')],
    'target': 'current',
}</field>
    </record>

    <menuitem id="menu_dolan_cot_settings" name="COT ARBA" parent="stock.menu_stock_config_settings"
              action="action_dolan_cot_company_settings" sequence="90" groups="base.group_system"/>
</odoo>
