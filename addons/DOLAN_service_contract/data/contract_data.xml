<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dolan_contract" model="ir.sequence">
            <field name="name">Contratos</field>
            <field name="code">dolan.contract</field>
            <field name="prefix">CT-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="index_ipc" model="dolan.contract.index">
            <field name="name">IPC (INDEC)</field>
            <field name="code">IPC</field>
        </record>
        <record id="index_icl" model="dolan.contract.index">
            <field name="name">ICL (BCRA, alquileres)</field>
            <field name="code">ICL</field>
        </record>
        <record id="index_cer" model="dolan.contract.index">
            <field name="name">CER (BCRA)</field>
            <field name="code">CER</field>
        </record>
        <record id="index_cac" model="dolan.contract.index">
            <field name="name">CAC (Cámara Argentina de la Construcción)</field>
            <field name="code">CAC</field>
        </record>
    </data>
    <record id="ir_cron_dolan_contract_daily" model="ir.cron">
        <field name="name">Contratos: ajustes, avisos y renovaciones</field>
        <field name="model_id" ref="model_dolan_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
