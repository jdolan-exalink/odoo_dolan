<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_hr_establishment_list" model="ir.ui.view">
        <field name="name">dolan.hr.establishment.list</field>
        <field name="model">dolan.hr.establishment</field>
        <field name="arch" type="xml">
            <list string="Establecimientos">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="address_id"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_hr_establishment_form" model="ir.ui.view">
        <field name="name">dolan.hr.establishment.form</field>
        <field name="model">dolan.hr.establishment</field>
        <field name="arch" type="xml">
            <form string="Establecimiento">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="address_id"/>
                            <field name="manager_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notas"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dolan_hr_establishment" model="ir.actions.act_window">
        <field name="name">Establecimientos</field>
        <field name="res_model">dolan.hr.establishment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
