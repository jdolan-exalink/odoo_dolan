<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dolan_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.form.dolan.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_servers_setting']" position="after">
                <setting string="WhatsApp para comprobantes (WAHA)"
                         help="Configure la conexión WAHA, vincule el teléfono y pruebe el servicio. Solo estará disponible para enviar facturas cuando la sesión esté conectada."
                         groups="base.group_system">
                    <div class="content-group mt16">
                        <button type="action"
                                name="%(action_dolan_whatsapp_accounts)d"
                                string="Configurar conexión WAHA"
                                icon="fa-whatsapp"
                                class="btn-link"/>
                        <div class="text-muted mt8">
                            La conexión se configura por empresa. Desde su ficha podrá probar WAHA, iniciar la sesión y vincular el teléfono con el código QR.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
