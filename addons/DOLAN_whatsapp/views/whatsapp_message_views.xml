<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_whatsapp_message_list" model="ir.ui.view">
        <field name="name">dolan.whatsapp.message.list</field>
        <field name="model">dolan.whatsapp.message</field>
        <field name="arch" type="xml">
            <list string="Mensajes de WhatsApp" create="0" edit="0" delete="0">
                <field name="message_date"/>
                <field name="direction" widget="badge"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="account_id"/>
                <field name="body" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_dolan_whatsapp_message_form" model="ir.ui.view">
        <field name="name">dolan.whatsapp.message.form</field>
        <field name="model">dolan.whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="Mensaje WhatsApp" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="company_id"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="chat_id"/>
                        <field name="direction"/>
                        <field name="state"/>
                        <field name="external_message_id"/>
                        <field name="message_date"/>
                    </group>
                    <group><field name="body" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dolan_whatsapp_messages" model="ir.actions.act_window">
        <field name="name">Mensajes</field>
        <field name="res_model">dolan.whatsapp.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
