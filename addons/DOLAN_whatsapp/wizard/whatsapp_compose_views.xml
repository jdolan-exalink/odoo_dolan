<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_whatsapp_compose_form" model="ir.ui.view">
        <field name="name">dolan.whatsapp.compose.form</field>
        <field name="model">dolan.whatsapp.compose</field>
        <field name="arch" type="xml">
            <form string="Enviar WhatsApp">
                <group>
                    <field name="partner_id"/>
                    <field name="phone"/>
                    <field name="account_id" domain="[('active', '=', True)]"/>
                    <field name="body" placeholder="Escriba el mensaje..."/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar mensaje" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
