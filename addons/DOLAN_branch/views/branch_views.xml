<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_branch_form" model="ir.ui.view">
        <field name="name">dolan.branch.form</field>
        <field name="model">dolan.branch</field>
        <field name="arch" type="xml">
            <form string="Sucursal">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_moves" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="move_count" widget="statinfo" string="Comprobantes"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Ej.: Sucursal Centro"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diarios" name="journals">
                            <field name="journal_ids" context="{'default_dolan_branch_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="code"/>
                                </list>
                            </field>
                            <p class="text-muted">Asigná acá el diario de ventas con el punto de venta fiscal de la sucursal y su caja.</p>
                        </page>
                        <page string="Usuarios" name="users">
                            <field name="user_ids" widget="many2many_tags_avatar"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dolan_branch_list" model="ir.ui.view">
        <field name="name">dolan.branch.list</field>
        <field name="model">dolan.branch</field>
        <field name="arch" type="xml">
            <list string="Sucursales">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="pricelist_id" optional="show"/>
                <field name="manager_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_dolan_branch" model="ir.actions.act_window">
        <field name="name">Sucursales</field>
        <field name="res_model">dolan.branch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá tu primera sucursal</p>
            <p>Una sucursal comparte el CUIT de la empresa y tiene su depósito, su punto de venta, su caja y sus usuarios.</p>
        </field>
    </record>

    <record id="view_users_form_dolan_branch" model="ir.ui.view">
        <field name="name">res.users.form.dolan.branch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Sucursales" name="dolan_branches">
                    <group>
                        <field name="dolan_branch_ids" widget="many2many_tags"/>
                        <field name="dolan_branch_id"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_account_journal_form_dolan_branch" model="ir.ui.view">
        <field name="name">account.journal.form.dolan.branch</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="dolan_branch_id"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_dolan_branch" model="ir.ui.view">
        <field name="name">account.move.form.dolan.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="dolan_branch_id" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_filter_dolan_branch" model="ir.ui.view">
        <field name="name">account.move.search.dolan.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="dolan_branch_id"/>
                <filter name="group_dolan_branch" string="Sucursal" context="{'group_by': 'dolan_branch_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_picking_search_dolan_branch" model="ir.ui.view">
        <field name="name">stock.picking.search.dolan.branch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="dolan_branch_id"/>
                <filter name="group_dolan_branch" string="Sucursal" context="{'group_by': 'dolan_branch_id'}"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_dolan_branch_root" name="Sucursales" sequence="98"
              groups="base.group_erp_manager" action="action_dolan_branch"
              web_icon="DOLAN_theme,static/src/lib/odoo/catalog_branches.svg"/>
</odoo>
