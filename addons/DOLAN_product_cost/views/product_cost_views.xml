<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_dolan_cost" model="ir.ui.view">
        <field name="name">product.template.form.dolan.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Costos" name="dolan_costs" groups="purchase.group_purchase_user">
                    <group>
                        <group string="Costo">
                            <field name="standard_price" string="Costo promedio" readonly="1"/>
                            <field name="dolan_replacement_source"/>
                            <field name="dolan_replacement_cost" readonly="dolan_replacement_source == 'last_purchase'"/>
                        </group>
                        <group string="Última compra">
                            <field name="dolan_last_purchase_price"/>
                            <field name="dolan_last_purchase_date"/>
                            <field name="dolan_last_supplier_id"/>
                        </group>
                        <group string="Margen">
                            <field name="dolan_margin_cost"/>
                            <field name="dolan_margin_pct"/>
                        </group>
                    </group>
                    <field name="dolan_cost_history_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Fecha"/>
                            <field name="cost_type"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="variation_pct"/>
                            <field name="partner_id"/>
                            <field name="origin"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_product_category_form_dolan_cost" model="ir.ui.view">
        <field name="name">product.category.form.dolan.cost</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="dolan_min_margin"/>
            </field>
        </field>
    </record>

    <record id="view_dolan_product_margin_list" model="ir.ui.view">
        <field name="name">dolan.product.margin.list</field>
        <field name="model">dolan.product.margin</field>
        <field name="arch" type="xml">
            <list string="Análisis de márgenes" create="false" edit="false" decoration-danger="alert">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar" display="always"/>
                    <button name="action_open_price_update" type="object" string="Actualizar precios de los seleccionados"/>
                </header>
                <field name="product_tmpl_id"/>
                <field name="categ_id" optional="show"/>
                <field name="list_price"/>
                <field name="average_cost"/>
                <field name="replacement_cost"/>
                <field name="replacement_vs_average" optional="show"/>
                <field name="last_purchase_price" optional="hide"/>
                <field name="last_purchase_date" optional="show"/>
                <field name="last_supplier_id" optional="hide"/>
                <field name="margin_pct"/>
                <field name="min_margin" optional="show"/>
                <field name="alert" widget="boolean" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_product_margin_search" model="ir.ui.view">
        <field name="name">dolan.product.margin.search</field>
        <field name="model">dolan.product.margin</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="categ_id"/>
                <field name="last_supplier_id"/>
                <filter name="alert" string="Margen bajo" domain="[('alert', '=', True)]"/>
                <filter name="negative" string="Costo mayor al precio" domain="[('margin_pct', '&lt;', 0)]"/>
                <filter name="repl_up" string="Reponer cuesta más que el promedio" domain="[('replacement_vs_average', '&gt;', 0)]"/>
                <filter name="no_purchase" string="Sin compras registradas" domain="[('last_purchase_date', '=', False)]"/>
                <group>
                    <filter name="group_categ" string="Categoría" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_supplier" string="Último proveedor" context="{'group_by': 'last_supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_product_margin" model="ir.actions.act_window">
        <field name="name">Análisis de márgenes</field>
        <field name="res_model">dolan.product.margin</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_dolan_product_margin_search"/>
        <field name="context">{'search_default_alert': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay productos con margen bajo</p>
            <p>Se actualiza todos los días; con «Actualizar» se recalcula en el momento.</p>
        </field>
    </record>

    <record id="view_dolan_product_cost_history_list" model="ir.ui.view">
        <field name="name">dolan.product.cost.history.list</field>
        <field name="model">dolan.product.cost.history</field>
        <field name="arch" type="xml">
            <list string="Historial de costos" create="false">
                <field name="create_date" string="Fecha"/>
                <field name="product_tmpl_id"/>
                <field name="cost_type"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="variation_pct"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dolan_product_cost_history_search" model="ir.ui.view">
        <field name="name">dolan.product.cost.history.search</field>
        <field name="model">dolan.product.cost.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <filter name="raises" string="Aumentos" domain="[('variation_pct', '&gt;', 0)]"/>
                <filter name="purchases" string="Compras" domain="[('cost_type', '=', 'purchase')]"/>
                <group>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dolan_product_cost_history" model="ir.actions.act_window">
        <field name="name">Historial de costos</field>
        <field name="res_model">dolan.product.cost.history</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <record id="view_res_company_form_dolan_cost" model="ir.ui.view">
        <field name="name">res.company.form.dolan.cost</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Costos" name="dolan_costs">
                    <group><field name="dolan_margin_cost_basis"/></group>
                </page>
            </notebook>
        </field>
    </record>

    <menuitem id="menu_dolan_product_cost_root" name="Costos" sequence="48"
              groups="purchase.group_purchase_user"
              web_icon="DOLAN_theme,static/src/lib/fluent_flat/catalog_costs.svg"/>
    <menuitem id="menu_dolan_product_margin" name="Análisis de márgenes" parent="menu_dolan_product_cost_root"
              action="action_dolan_product_margin" sequence="10"/>
    <menuitem id="menu_dolan_product_cost_history" name="Historial de costos" parent="menu_dolan_product_cost_root"
              action="action_dolan_product_cost_history" sequence="20"/>
</odoo>
