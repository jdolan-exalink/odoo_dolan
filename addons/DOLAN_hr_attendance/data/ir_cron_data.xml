<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_dolan_clock_process" model="ir.cron">
            <field name="name">Personal: emparejar fichadas pendientes</field>
            <field name="model_id" ref="model_dolan_hr_clock_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_dolan_process_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_dolan_attendance_reconcile" model="ir.cron">
            <field name="name">Personal: conciliar turnos y fichadas (últimos 7 días)</field>
            <field name="model_id" ref="model_dolan_hr_attendance_incident"/>
            <field name="state">code</field>
            <field name="code">model._cron_dolan_reconcile()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
