<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_dolan_logistics" model="res.groups.privilege">
        <field name="name">Logística</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>
    <record id="group_logistics_driver" model="res.groups">
        <field name="name">Repartidor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_logistics"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ve sus rutas y registra la prueba de entrega y lo cobrado en cada parada.</field>
    </record>
    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Responsable de logística</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_logistics"/>
        <field name="implied_ids" eval="[(4, ref('group_logistics_driver')), (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Arma oleadas de preparación y hojas de ruta, y cierra las rutas.</field>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_logistics_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_logistics_manager'))]"/>
    </record>
</odoo>
