<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asistente de Importación Universal de Extractos Bancarios -->
    <record id="view_dolan_bank_statement_import_wizard_form" model="ir.ui.view">
        <field name="name">dolan.bank.statement.import.wizard.form</field>
        <field name="model">dolan.bank.statement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Extracto Bancario (CSV / XLSX / OFX / CAMT.053)">
                <group>
                    <group>
                        <field name="journal_id"/>
                        <field name="file_format"/>
                    </group>
                    <group>
                        <field name="attachment_filename" invisible="1"/>
                        <field name="attachment_file" filename="attachment_filename"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import_statement"
                            type="object"
                            string="Importar Extracto"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dolan_bank_statement_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Extracto Bancario (CSV/XLSX/OFX/CAMT)</field>
        <field name="res_model">dolan.bank.statement.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Asistente de Conciliación Bancaria Rápida -->
    <record id="view_dolan_bank_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">dolan.bank.reconciliation.wizard.form</field>
        <field name="model">dolan.bank.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Conciliación Bancaria">
                <header>
                    <button name="action_reconcile_selected"
                            type="object"
                            string="Procesar líneas seleccionadas"
                            class="oe_highlight"/>
                    <button name="action_undo_selected"
                            type="object"
                            string="Deshacer conciliaciones seleccionadas"
                            class="btn-secondary"/>
                </header>
                <group>
                    <group>
                        <field name="journal_id"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Los pagos se emparejan automáticamente solo con coincidencia exacta. Para una cobranza neta con comisión retenida, seleccione explícitamente el pago y una cuenta de gasto: se conciliará el pago completo y la diferencia se imputará como gasto. Para cargos sin pago asociado, elija una cuenta y se usará el importe exacto del extracto. El tratamiento fiscal debe definirlo el contador. Para deshacer, marque la columna correspondiente y use la acción nativa de Odoo; se respetan los bloqueos contables.
                </div>
                <field name="line_ids">
                    <list string="Movimientos de Extracto Pendientes" editable="bottom">
                        <field name="to_reconcile"/>
                        <field name="to_undo"/>
                        <field name="is_reconciled" readonly="1"/>
                        <field name="date"/>
                        <field name="payment_ref"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="matched_payment_id"/>
                        <field name="payment_difference_payment_id"/>
                        <field name="writeoff_account_id"/>
                        <field name="company_id" column_invisible="True"/>
                        <field name="statement_line_id" column_invisible="True"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="action_dolan_bank_reconciliation_wizard" model="ir.actions.act_window">
        <field name="name">Conciliación Bancaria Rápida</field>
        <field name="res_model">dolan.bank.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
