<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================== -->
    <!-- ACCIONES PREFILTRADAS DE REPORTES CONTABLES Y REVISIONES (1 A 1 EXALINK)-->
    <!-- ====================================================================== -->
    <record id="action_dolan_report_balance_sheet" model="ir.actions.act_window">
        <field name="name">Balance general</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'balance_sheet'}</field>
    </record>

    <record id="action_dolan_report_profit_loss" model="ir.actions.act_window">
        <field name="name">Estado de resultados (P&amp;L)</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'profit_loss'}</field>
    </record>

    <record id="action_dolan_report_cash_flow" model="ir.actions.act_window">
        <field name="name">Estado de flujo de efectivo</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'cash_flow'}</field>
    </record>

    <record id="action_dolan_report_general_ledger" model="ir.actions.act_window">
        <field name="name">Libro mayor</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'general_ledger'}</field>
    </record>

    <record id="action_dolan_report_general_journal" model="ir.actions.act_window">
        <field name="name">Libro Diario</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'general_journal'}</field>
    </record>

    <record id="action_dolan_report_executive_summary" model="ir.actions.act_window">
        <field name="name">Resumen ejecutivo</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'executive_summary'}</field>
    </record>

    <record id="action_dolan_report_trial_balance" model="ir.actions.act_window">
        <field name="name">Balance de comprobación (Sumas y Saldos)</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'trial_balance'}</field>
    </record>

    <record id="action_dolan_report_aged_receivable" model="ir.actions.act_window">
        <field name="name">Cuentas por cobrar vencidas</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'aged_receivable'}</field>
    </record>

    <record id="action_dolan_report_aged_payable" model="ir.actions.act_window">
        <field name="name">Cuentas por pagar vencidas</field>
        <field name="res_model">dolan.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'aged_payable'}</field>
    </record>

    <!-- ====================================================================== -->
    <!-- 1. INTEGRACIÓN COMPLETA EN FACTURACIÓN (account.menu_finance)          -->
    <!-- ====================================================================== -->

    <!-- Facturación / Contabilidad / Activos y pasivos -->
    <menuitem id="menu_finance_assets_liabilities"
              name="Activos y pasivos"
              parent="account.menu_finance_entries"
              sequence="15"/>

    <menuitem id="menu_finance_assets"
              name="Activos"
              parent="menu_finance_assets_liabilities"
              action="action_dolan_account_asset"
              sequence="10"/>

    <menuitem id="menu_finance_loans"
              name="Préstamos"
              parent="menu_finance_assets_liabilities"
              action="action_dolan_account_loan"
              sequence="20"/>

    <!-- Facturación / Contabilidad / Cierre (account.account_closing_menu) -->
    <menuitem id="menu_finance_closing_reconcile"
              name="Conciliar"
              parent="account.account_closing_menu"
              action="action_dolan_bank_reconciliation_wizard"
              sequence="5"/>

    <menuitem id="menu_finance_closing_import"
              name="Importar extracto (CSV/XLSX/OFX/CAMT)"
              parent="account.account_closing_menu"
              action="action_dolan_bank_statement_import_wizard"
              sequence="8"/>

    <menuitem id="menu_finance_closing_tax_returns"
              name="Declaraciones de impuestos"
              parent="account.account_closing_menu"
              action="action_dolan_financial_report_wizard"
              sequence="25"/>

    <!-- Facturación / Revisión (account.account_audit_menu) -->
    <menuitem id="menu_finance_review_regularization"
              name="Asientos de regularización"
              parent="account.account_audit_menu"
              sequence="30"/>

    <menuitem id="menu_finance_review_deferred_revenue"
              name="Ingresos diferidos"
              parent="menu_finance_review_regularization"
              action="account.action_move_journal_line"
              sequence="10"/>

    <menuitem id="menu_finance_review_deferred_expense"
              name="Gastos diferidos"
              parent="menu_finance_review_regularization"
              action="account.action_move_journal_line"
              sequence="20"/>

    <menuitem id="menu_finance_review_audit"
              name="Auditoría"
              parent="account.account_audit_menu"
              sequence="40"/>

    <menuitem id="menu_finance_review_annual_report"
              name="Informe anual"
              parent="menu_finance_review_audit"
              action="action_dolan_report_balance_sheet"
              sequence="10"/>

    <!-- Facturación / Reportes / Reportes de estados de cuenta -->
    <menuitem id="menu_finance_report_bs"
              name="Balance general"
              parent="account.account_reports_legal_statements_menu"
              action="action_dolan_report_balance_sheet"
              sequence="10"/>

    <menuitem id="menu_finance_report_pl"
              name="Estado de resultados"
              parent="account.account_reports_legal_statements_menu"
              action="action_dolan_report_profit_loss"
              sequence="20"/>

    <menuitem id="menu_finance_report_cf"
              name="Estado de flujo de efectivo"
              parent="account.account_reports_legal_statements_menu"
              action="action_dolan_report_cash_flow"
              sequence="30"/>

    <menuitem id="menu_finance_report_depreciation"
              name="Tabla de amortización"
              parent="account.account_reports_legal_statements_menu"
              action="action_dolan_asset_depreciation_schedule"
              sequence="40"/>

    <!-- Facturación / Reportes / Libros mayores -->
    <menuitem id="menu_finance_reports_ledgers"
              name="Libros mayores"
              parent="account.menu_finance_reports"
              sequence="12"/>

    <menuitem id="menu_finance_report_gl"
              name="Libro mayor"
              parent="menu_finance_reports_ledgers"
              action="action_dolan_report_general_ledger"
              sequence="10"/>

    <menuitem id="menu_finance_report_general_journal"
              name="Libro Diario"
              parent="menu_finance_reports_ledgers"
              action="action_dolan_report_general_journal"
              sequence="15"/>

    <menuitem id="menu_finance_report_tb"
              name="Balance de comprobación"
              parent="menu_finance_reports_ledgers"
              action="action_dolan_report_trial_balance"
              sequence="20"/>

    <!-- Facturación / Reportes / Reportes del contacto -->
    <menuitem id="menu_finance_report_partner_ledger"
              name="Libro mayor de empresa"
              parent="account.account_reports_partners_reports_menu"
              action="action_dolan_report_general_ledger"
              sequence="10"/>

    <menuitem id="menu_finance_report_aged_receivable"
              name="Cuentas por cobrar vencidas"
              parent="account.account_reports_partners_reports_menu"
              action="action_dolan_report_aged_receivable"
              sequence="20"/>

    <menuitem id="menu_finance_report_aged_payable"
              name="Cuentas por pagar vencidas"
              parent="account.account_reports_partners_reports_menu"
              action="action_dolan_report_aged_payable"
              sequence="30"/>

    <menuitem id="menu_finance_report_customer_statement"
              name="Estado de cuenta del cliente"
              parent="account.account_reports_partners_reports_menu"
              action="action_dolan_partner_followup_list"
              sequence="40"/>

    <!-- Facturación / Reportes / Impuestos y finanzas -->
    <menuitem id="menu_finance_report_tax"
              name="Informe de impuestos"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="action_dolan_financial_report_wizard"
              sequence="10"/>

    <menuitem id="menu_finance_report_fiscal"
              name="Informe fiscal"
              parent="account.account_reports_taxes_and_fiscal_menu"
              action="action_dolan_financial_report_wizard"
              sequence="20"/>

    <!-- Facturación / Reportes / Gestión -->
    <menuitem id="menu_finance_report_exec_summary"
              name="Resumen ejecutivo"
              parent="account.account_reports_management_menu"
              action="action_dolan_report_executive_summary"
              sequence="5"/>

    <menuitem id="menu_finance_report_loans"
              name="Análisis de préstamos"
              parent="account.account_reports_management_menu"
              action="action_dolan_loan_analysis"
              sequence="50"/>

    <!-- Facturación / Configuración / Contabilidad -->
    <menuitem id="menu_finance_config_depreciation_models"
              name="Modelos de depreciación"
              parent="account.account_account_menu"
              action="action_dolan_account_asset"
              sequence="45"/>

    <menuitem id="menu_finance_config_followup_levels"
              name="Recordatorios de factura (Niveles de mora)"
              parent="account.account_account_menu"
              action="action_dolan_followup_level"
              sequence="46"/>

    <menuitem id="menu_finance_config_online_sync"
              name="Sincronización e importación bancaria"
              parent="account.account_account_menu"
              action="action_dolan_bank_statement_import_wizard"
              sequence="47"/>

    <!-- Separate navigation; all transactions remain in native account models. -->
    <menuitem id="account.menu_finance" name="Facturación" sequence="55"
              web_icon="account,static/description/icon.png"
              groups="account.group_account_readonly,account.group_account_invoice"/>
    <menuitem id="menu_dolan_accounting_root" name="Contabilidad" sequence="60"
              web_icon="DOLAN_accounting,static/description/icon.svg"
              groups="account.group_account_readonly,account.group_account_user,account.group_account_manager"/>
    <menuitem id="menu_dolan_accounting_dashboard" name="Tablero" sequence="1"
              parent="menu_dolan_accounting_root"
              action="account.open_account_journal_dashboard_kanban"
              groups="account.group_account_basic"/>
    <menuitem id="menu_dolan_accounting_customers" name="Clientes" sequence="2"
              parent="menu_dolan_accounting_root"/>
    <menuitem id="menu_dolan_accounting_vendors" name="Proveedores" sequence="3"
              parent="menu_dolan_accounting_root"/>
    <menuitem id="menu_dolan_accounting_customers_invoices" name="Facturas" parent="menu_dolan_accounting_customers" action="account.action_move_out_invoice" sequence="10"/>
    <menuitem id="menu_dolan_accounting_customers_refunds" name="Notas de crédito" parent="menu_dolan_accounting_customers" action="account.action_move_out_refund_type_non_legacy" sequence="20"/>
    <menuitem id="menu_dolan_accounting_customers_payments" name="Pagos" parent="menu_dolan_accounting_customers" action="account.action_account_payments" sequence="30"/>
    <menuitem id="menu_dolan_accounting_customers_checks" name="Cheques de terceros" parent="menu_dolan_accounting_customers" action="l10n_latam_check.action_third_party_check" sequence="40"/>
    <menuitem id="menu_dolan_accounting_customers_partners" name="Clientes" parent="menu_dolan_accounting_customers" action="account.res_partner_action_customer" sequence="50"/>
    <menuitem id="menu_dolan_accounting_vendors_invoices" name="Facturas" parent="menu_dolan_accounting_vendors" action="account.action_move_in_invoice" sequence="10"/>
    <menuitem id="menu_dolan_accounting_vendors_refunds" name="Reembolsos" parent="menu_dolan_accounting_vendors" action="account.action_move_in_refund_type" sequence="20"/>
    <menuitem id="menu_dolan_accounting_vendors_payments" name="Pagos" parent="menu_dolan_accounting_vendors" action="account.action_account_payments_payable" sequence="30"/>
    <menuitem id="menu_dolan_accounting_vendors_checks" name="Cheques propios" parent="menu_dolan_accounting_vendors" action="l10n_latam_check.action_own_check" sequence="40"/>
    <menuitem id="menu_dolan_accounting_vendors_partners" name="Proveedores" parent="menu_dolan_accounting_vendors" action="account.res_partner_action_supplier" sequence="50"/>
    <record id="account.menu_finance_entries" model="ir.ui.menu"><field name="parent_id" ref="menu_dolan_accounting_root"/></record>
    <record id="account.account_audit_menu" model="ir.ui.menu"><field name="parent_id" ref="menu_dolan_accounting_root"/></record>
    <record id="account.menu_finance_reports" model="ir.ui.menu"><field name="parent_id" ref="menu_dolan_accounting_root"/></record>
    <record id="account.menu_finance_configuration" model="ir.ui.menu"><field name="parent_id" ref="menu_dolan_accounting_root"/></record>
    <menuitem id="menu_dolan_invoicing_reports" name="Informes" parent="account.menu_finance" sequence="20"/>
    <record id="action_dolan_invoice_analysis_by_document" model="ir.actions.act_window">
        <field name="name">Análisis de facturas</field>
        <field name="res_model">account.invoice.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'search_default_current': 1, 'search_default_customer': 1, 'group_by': ['invoice_date:month', 'move_id']}</field>
    </record>
    <menuitem id="menu_dolan_invoicing_analysis" name="Análisis de facturas" parent="menu_dolan_invoicing_reports" action="action_dolan_invoice_analysis_by_document"/>
    <menuitem id="menu_dolan_invoicing_third_party_checks" name="Cheques de terceros"
              parent="account.menu_finance" action="l10n_latam_check.action_third_party_check"
              sequence="45"
              groups="account.group_account_invoice,account.group_account_readonly,account.group_account_user,account.group_account_manager"/>
    <menuitem id="menu_dolan_invoicing_own_checks" name="Cheques propios"
              parent="account.menu_finance" action="l10n_latam_check.action_own_check"
              sequence="46"
              groups="account.group_account_invoice,account.group_account_readonly,account.group_account_user,account.group_account_manager"/>
</odoo>
