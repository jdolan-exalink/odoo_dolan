<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dolan_appointment" model="ir.module.category">
        <field name="name">Servicios (DOLAN): turnos</field>
        <field name="sequence">41</field>
    </record>
    <record id="res_groups_privilege_dolan_appointment" model="res.groups.privilege">
        <field name="name">Agenda de turnos</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_dolan_appointment"/>
    </record>
    <record id="group_appointment_user" model="res.groups">
        <field name="name">Recepción</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_appointment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Da, mueve y cancela turnos.</field>
    </record>
    <record id="group_appointment_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dolan_appointment"/>
        <field name="implied_ids" eval="[(4, ref('group_appointment_user'))]"/>
        <field name="comment">Además configura servicios y profesionales.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_appointment_manager'))]"/>
    </record>
</odoo>
