<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_screen_preference_form" model="ir.ui.view">
        <field name="name">dolan.screen.preference.form</field>
        <field name="model">dolan.screen.preference</field>
        <field name="arch" type="xml">
            <form string="Configuración de pantalla">
                <sheet>
                    <div class="oe_title">
                        <h1>Mi pantalla</h1>
                        <div class="text-muted">Personalizá cómo se ve Odoo para tu usuario.</div>
                    </div>
                    <group>
                        <group string="Tema y lectura">
                            <field name="user_id" readonly="1" groups="base.group_system"/>
                            <field name="theme_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="allow_user_icon_style" invisible="1"/>
                            <field name="icon_style" readonly="not allow_user_icon_style"/>
                            <field name="allow_user_appearance" invisible="1"/>
                            <field name="compact_mode" widget="boolean_toggle" readonly="not allow_user_appearance"/>
                        </group>
                        <group string="Apariencia de la empresa" groups="base.group_system">
                            <field name="company_id"/>
                            <field name="primary_color" widget="color"/>
                            <field name="secondary_color" widget="color"/>
                            <field name="home_bg_style"/>
                            <field name="full_width_sheets" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Aplicaciones visibles">
                        <field name="hidden_app_menu_ids" widget="many2many_tags" options="{'no_create': true, 'no_create_edit': true}"/>
                        <div class="text-muted">
                            Las aplicaciones seleccionadas se ocultan de la grilla de Inicio. Esto no cambia tus permisos y no desinstala ninguna aplicación.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_dolan_screen_preferences" model="ir.actions.server">
        <field name="name">Configuración de pantalla</field>
        <field name="model_id" ref="model_dolan_screen_preference"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_current_user()</field>
    </record>

    <menuitem id="menu_dolan_screen_preferences"
              name="Configuración de pantalla"
              parent="DOLAN_base.menu_dolan_root_config"
              action="action_open_dolan_screen_preferences"
              sequence="30"
              groups="base.group_user"/>
</odoo>
