<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dolan_icon_assignment_list" model="ir.ui.view">
        <field name="name">dolan.icon.assignment.list</field>
        <field name="model">dolan.icon.assignment</field>
        <field name="arch" type="xml">
            <list string="Administrador de iconos">
                <field name="semantic_id"/>
                <field name="fluent_3d_asset" string="Fluent 3D"/>
                <field name="fluent_flat_asset" string="Fluent Flat"/>
                <field name="fluent_filled_asset" string="Fluent Filled"/>
                <field name="fluent_regular_asset" string="Fluent Outline"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_dolan_icon_assignment_form" model="ir.ui.view">
        <field name="name">dolan.icon.assignment.form</field>
        <field name="model">dolan.icon.assignment</field>
        <field name="arch" type="xml">
            <form string="Asignación de icono">
                <sheet>
                    <div class="oe_title"><h1>Asignación semántica de icono</h1></div>
                    <group>
                        <field name="semantic_id"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Vista previa y recursos locales" col="2">
                        <group string="Fluent 3D">
                            <field name="fluent_preview" widget="image" options="{'size': [128, 128]}"/>
                            <field name="fluent_3d_asset"/>
                        </group>
                        <group string="Fluent Flat">
                            <field name="flat_preview" widget="image" options="{'size': [128, 128]}"/>
                            <field name="fluent_flat_asset"/>
                        </group>
                        <group string="Fluent Filled">
                            <field name="filled_preview" widget="image" options="{'size': [128, 128]}"/>
                            <field name="fluent_filled_asset"/>
                        </group>
                        <group string="Fluent Outline">
                            <field name="regular_preview" widget="image" options="{'size': [128, 128]}"/>
                            <field name="fluent_regular_asset"/>
                        </group>
                        <group string="Compatibilidad anterior">
                            <field name="fluent_asset"/>
                            <field name="tabler_preview" widget="image" options="{'size': [128, 128]}"/>
                            <field name="tabler_asset"/>
                        </group>
                    </group>
                    <div class="text-muted">Cada variante toma su recurso del catálogo local. Las asignaciones antiguas se conservan como compatibilidad. Las rutas y URL manuales no están permitidas.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dolan_icon_assignment" model="ir.actions.act_window">
        <field name="name">Administrador de iconos</field>
        <field name="res_model">dolan.icon.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dolan_icon_assignment" name="Administrador de iconos"
              parent="DOLAN_base.menu_dolan_root_config" action="action_dolan_icon_assignment"
              sequence="35" groups="base.group_system"/>
</odoo>
