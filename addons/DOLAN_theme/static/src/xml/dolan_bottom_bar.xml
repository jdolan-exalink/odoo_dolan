<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="DOLAN_theme.BottomBar">
        <nav class="o_dolan_bottom_bar d-md-none position-fixed bottom-0 start-0 end-0 d-flex justify-content-around align-items-center"
             aria-label="Navegación móvil inferior">
            <!-- 1. Inicio / Apps -->
            <button type="button"
                    class="o_dolan_bottom_item btn btn-link p-0 d-flex flex-column align-items-center justify-content-center text-decoration-none"
                    title="Inicio / Aplicaciones"
                    t-on-click="() => this.onHomeClick()">
                <div class="o_dolan_bottom_icon d-flex align-items-center justify-content-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </div>
                <span class="o_dolan_bottom_label">Inicio</span>
            </button>

            <!-- 2. Búsqueda Global (Ctrl+K) -->
            <button type="button"
                    class="o_dolan_bottom_item btn btn-link p-0 d-flex flex-column align-items-center justify-content-center text-decoration-none"
                    title="Buscar (Ctrl+K)"
                    t-on-click="() => this.onSearchClick()">
                <div class="o_dolan_bottom_icon d-flex align-items-center justify-content-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                <span class="o_dolan_bottom_label">Buscar</span>
            </button>

            <!-- 3. IA Copilot (ChatGPT) -->
            <button type="button"
                    class="o_dolan_bottom_item o_dolan_bottom_item_ai btn btn-link p-0 d-flex flex-column align-items-center justify-content-center text-decoration-none"
                    title="Asistente AI"
                    t-on-click="() => this.onAiClick()">
                <div class="o_dolan_bottom_icon_ai d-flex align-items-center justify-content-center shadow-sm">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/>
                        <rect x="4" y="8" width="16" height="12" rx="4"/>
                        <circle cx="9" cy="13" r="1" fill="white"/>
                        <circle cx="15" cy="13" r="1" fill="white"/>
                    </svg>
                </div>
                <span class="o_dolan_bottom_label">AI</span>
            </button>

            <!-- 4. Chat interno de Odoo -->
            <button type="button"
                    class="o_dolan_bottom_item btn btn-link p-0 d-flex flex-column align-items-center justify-content-center text-decoration-none"
                    title="Chat de Odoo"
                    t-on-click="() => this.onMessagesClick()">
                <div class="o_dolan_bottom_icon d-flex align-items-center justify-content-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    </svg>
                </div>
                <span class="o_dolan_bottom_label">Chat</span>
            </button>

            <!-- 5. Acciones Rápidas -->
            <button type="button"
                    class="o_dolan_bottom_item btn btn-link p-0 d-flex flex-column align-items-center justify-content-center text-decoration-none"
                    title="Acciones Rápidas"
                    t-on-click="() => this.onQuickActionsClick()">
                <div class="o_dolan_bottom_icon d-flex align-items-center justify-content-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>
                </div>
                <span class="o_dolan_bottom_label">Rápido</span>
            </button>
        </nav>
    </t>
</templates>
